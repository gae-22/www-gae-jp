[Unit]
Description=www-gae-jp Astro Node.js Server
After=network.target

[Service]
Type=simple
User=gae
Group=gae
WorkingDirectory=/var/www/www-gae-jp
ExecStart=/usr/bin/node /var/www/www-gae-jp/dist/server/entry.mjs
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=8005
Environment=HOST=0.0.0.0

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/www-gae-jp
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=www-gae-jp

[Install]
WantedBy=multi-user.target
