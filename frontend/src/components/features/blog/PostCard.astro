---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'featured' | 'basic';
  class?: string;
  style?: string;
}

const { post, variant = 'basic', class: className, style } = Astro.props;
---

<a href={`/blog/${post.slug}`} class:list={["group relative block h-full", className]} style={style} data-cursor-text="Read" data-magnetic>
  <article class="project-card h-full flex flex-col overflow-hidden">

    <!-- Cover Image -->
    <div class="w-full aspect-video overflow-hidden relative bg-void-elevated shimmer-hover">
        {post.data.cover ? (
            <Image
                src={post.data.cover}
                alt={post.data.coverAlt || post.data.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 grayscale group-hover:grayscale-0"
            />
        ) : (
            <div class="w-full h-full flex items-center justify-center">
                 <Icon name="lucide:image" class="w-10 h-10 text-text-tertiary" />
            </div>
        )}

        {/* Date Badge */}
        <div class="absolute top-4 left-4 bg-void/80 backdrop-blur-md px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-wider text-text-secondary border border-border-subtle">
             <time datetime={post.data.publishedAt.toISOString()}>
              {post.data.publishedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
        </div>
    </div>

    <!-- Content -->
    <div class="p-6 flex flex-col flex-1">
      <div class="flex gap-2 mb-3">
          {post.data.tags.slice(0, 2).map(tag => (
              <span class="text-[10px] font-mono uppercase tracking-wider text-accent bg-accent-dim px-2 py-0.5 rounded">
                  {tag}
              </span>
          ))}
      </div>

      <h3 class="text-xl font-heading font-bold text-text-primary mb-3 leading-tight group-hover:text-accent transition-colors duration-300">
        {post.data.title}
      </h3>

      <p class="text-sm text-text-secondary leading-relaxed line-clamp-2 mb-6 flex-1">
        {post.data.description}
      </p>

      <div class="flex items-center gap-2 text-xs font-mono text-accent">
        <span class="group-hover:translate-x-1 transition-transform duration-300">Read Article</span>
        <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-300" />
      </div>
    </div>

  </article>
</a>
