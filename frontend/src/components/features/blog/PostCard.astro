---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'featured' | 'basic';
  class?: string;
}

const { post, variant = 'basic', class: className } = Astro.props;
const isFeatured = variant === 'featured';
---

<a href={`/blog/${post.slug}`} class:list={["group relative block h-full hover-target", className]}>
  <article class="rounded-2xl overflow-hidden h-full flex flex-col transition-all duration-500 ease-out hover:shadow-[0_0_40px_color-mix(in_srgb,var(--color-accent)_10%,transparent)]"
           style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>

    <!-- Cover Image -->
    <div class:list={["w-full overflow-hidden relative", isFeatured ? "aspect-21/9" : "aspect-video"]}>
        {post.data.cover ? (
            <Image
                src={post.data.cover}
                alt={post.data.coverAlt || post.data.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
        ) : (
            <div class="w-full h-full flex items-center justify-center relative overflow-hidden"
                 style={`background: linear-gradient(135deg, var(--color-surface-2), var(--color-surface));`}>
                <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 24px 24px;"></div>
                <span class="font-display font-bold text-4xl opacity-5" style={`color: var(--color-text);`}>gae</span>
            </div>
        )}
        {post.data.tags.length > 0 && (
            <div class="absolute top-4 left-4 flex gap-2">
                {post.data.tags.slice(0, isFeatured ? 3 : 1).map(tag => (
                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-mono font-bold uppercase tracking-wider"
                          style="background: rgba(0,0,0,0.5); color: rgba(255,255,255,0.9); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.1);">
                        {tag}
                    </span>
                ))}
            </div>
        )}
    </div>

    <!-- Content -->
    <div class:list={["flex-1 flex flex-col", isFeatured ? "p-8 lg:p-10" : "p-6 lg:p-8"]}>
      <div class="flex items-center gap-3 text-[10px] font-mono uppercase tracking-[0.2em] mb-4" style={`color: var(--color-text-muted);`}>
        <time datetime={post.data.publishedAt.toISOString()}>
          {post.data.publishedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>
      </div>

      <h3 class:list={[
        "font-display font-semibold mb-3 leading-tight transition-colors duration-300",
        isFeatured ? "text-2xl lg:text-3xl" : "text-lg lg:text-xl"
      ]} style={`color: var(--color-text);`}>
        {post.data.title}
      </h3>

      <p class:list={[
        "leading-relaxed mb-6 flex-1 text-balance",
        isFeatured ? "text-base line-clamp-3" : "text-sm line-clamp-2"
      ]} style={`color: var(--color-text-muted);`}>
        {post.data.description}
      </p>

      <div class="flex items-center gap-2 text-xs font-semibold transition-colors duration-300 mt-auto" style={`color: var(--color-text-muted);`}>
        <span class="relative group-hover:text-accent transition-colors duration-300">
            Read Article
            <span class="absolute -bottom-1 left-0 w-full h-px transform scale-x-0 group-hover:scale-x-100 transition-transform duration-400 origin-left" style={`background: var(--color-accent);`}></span>
        </span>
        <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300" />
      </div>
    </div>
  </article>
</a>
