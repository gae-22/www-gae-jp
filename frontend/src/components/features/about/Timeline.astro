---
export interface Props {
    events: {
        year: string;
        title: string;
        company: string;
        description?: string;
    }[];
}

const { events } = Astro.props;
---

<div class="relative ml-4 space-y-8 py-4">
  <!-- Vertical Line -->
  <div class="absolute left-0 top-0 bottom-0 w-px bg-linear-to-b from-accent-blue via-accent-violet to-transparent"></div>

  {events.map((event, index) => (
    <div class="relative pl-8 group">
      {/* Dot */}
      <div class="absolute -left-1.25 top-6 w-2.5 h-2.5 rounded-full bg-white border-2 border-accent-blue z-10 transition-transform duration-300 group-hover:scale-125 group-hover:bg-accent-blue"></div>

      {/* Content */}
      <div class="glass-card p-6 rounded-2xl transition-all duration-300 hover:shadow-md hover:-translate-y-1">

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2">
           <h3 class="text-lg font-display font-bold text-text-primary">{event.title}</h3>
           <span class="text-xs font-mono font-medium text-accent-violet bg-accent-violet/5 px-2 py-0.5 rounded">
             {event.year}
           </span>
        </div>

        <div class="mb-3">
             <span class="text-sm font-medium text-zinc-500">@ {event.company}</span>
        </div>

        {event.description && (
            <p class="text-sm leading-relaxed text-zinc-600">
                {event.description}
            </p>
        )}

      </div>
    </div>
  ))}
</div>
