---
export interface Props {
    events: {
        year: string;
        title: string;
        company: string;
        description?: string;
    }[];
}

const { events } = Astro.props;
---

<div class="relative ml-4 space-y-10 py-4">
  <!-- Vertical line -->
  <div class="absolute left-0 top-0 bottom-0 w-px bg-linear-to-b from-accent-indigo/20 via-stone-200 to-transparent"></div>

  {events.map((event, index) => (
    <div class={`relative pl-10 group reveal reveal-delay-${Math.min(index, 4)}`}>
      {/* Dot */}
      <div class="absolute -left-1.25 top-2.5 w-2.5 h-2.5 rounded-full bg-white border-2 border-stone-300 group-hover:border-accent-indigo group-hover:bg-accent-indigo group-hover:shadow-[0_0_12px_rgba(67,56,202,0.25)] transition-all duration-400"></div>

      {/* Grid Layout */}
      <div class="grid grid-cols-1 sm:grid-cols-[8.5rem_1fr] gap-2 sm:gap-6">

        {/* Year Column */}
        <div class="flex-none pt-1">
          <span class="text-accent-teal font-mono text-sm font-medium whitespace-nowrap block">
            {event.year.includes('-') ? event.year.replace('-', ' — ') : event.year}
          </span>
        </div>

        {/* Content Column */}
        <div class="flex flex-col gap-1.5 p-5 -mt-2 rounded-2xl bg-transparent group-hover:bg-stone-50/60 transition-all duration-400">
           <div class="flex flex-col sm:flex-row sm:items-baseline gap-2">
               <h3 class="text-lg font-display font-bold text-ink leading-tight">{event.title}</h3>
               <span class="text-ink-muted text-sm">@ {event.company}</span>
           </div>

           {event.description && (
            <p class="text-ink-muted text-sm leading-relaxed max-w-xl mt-0.5">
                {event.description}
            </p>
           )}
        </div>
      </div>
    </div>
  ))}
</div>
