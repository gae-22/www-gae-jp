---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = (await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const latestPost = posts[0];

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}
---

<section class="relative z-10 py-40 md:py-56 px-6">
  <div class="max-w-5xl mx-auto">

    <!-- Section Label with line -->
    <div class="flex items-center gap-6 mb-20 reveal-item">
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">
        Latest Article
      </span>
      <div class="flex-1 h-px bg-border-subtle"></div>
    </div>

    {latestPost ? (
      <a href={`/blog/${latestPost.slug}`} class="reveal-item block group" data-cursor-text="Read">

        {/* Cover Image with parallax wrapper */}
        {latestPost.data.cover && (
          <div class="relative overflow-hidden rounded-2xl mb-10 parallax-container latest-post-image-wrap">
            <Image
              src={latestPost.data.cover}
              alt={latestPost.data.coverAlt || ''}
              class="w-full h-[35vh] md:h-[55vh] object-cover grayscale group-hover:grayscale-0 transition-all duration-700 ease-out group-hover:scale-[1.03] parallax-image"
            />
            {/* Overlay gradient */}
            <div class="absolute inset-0 bg-linear-to-t from-void/60 via-transparent to-transparent pointer-events-none"></div>
            {/* Shimmer line on hover */}
            <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity duration-700">
              <div class="image-shimmer"></div>
            </div>
          </div>
        )}

        {/* Content */}
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div class="flex-1">
            {/* Meta */}
            <div class="flex items-center gap-4 mb-5">
              <time class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-tertiary">
                {formatDate(latestPost.data.publishedAt)}
              </time>
              {latestPost.data.tags.length > 0 && (
                <>
                  <span class="w-1 h-1 rounded-full bg-text-tertiary"></span>
                  <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-tertiary">
                    {latestPost.data.tags[0]}
                  </span>
                </>
              )}
            </div>

            {/* Title */}
            <h3 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary group-hover:text-accent transition-colors duration-300 mb-4 leading-[1.1]">
              {latestPost.data.title}
            </h3>

            {/* Description */}
            <p class="font-body text-base text-text-secondary max-w-2xl leading-relaxed">
              {latestPost.data.description}
            </p>
          </div>

          {/* Read link */}
          <div class="shrink-0">
            <span class="link-hover font-mono text-sm text-accent inline-flex items-center gap-2 group-hover:gap-3 transition-all duration-300">
              Read
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </div>
        </div>

      </a>
    ) : (
      <div class="reveal-item">
        <p class="text-xl text-text-tertiary font-body mb-6">No articles yet.</p>
        <a href="/blog" class="link-hover font-mono text-sm text-accent inline-flex items-center gap-2">
          Visit Blog
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}

  </div>
</section>

<script>
  function initParallax() {
    const containers = document.querySelectorAll<HTMLElement>('.parallax-container');
    if (!containers.length) return;

    const handleScroll = () => {
      containers.forEach(container => {
        const img = container.querySelector<HTMLElement>('.parallax-image');
        if (!img) return;

        const rect = container.getBoundingClientRect();
        const windowH = window.innerHeight;

        if (rect.top < windowH && rect.bottom > 0) {
          const progress = (windowH - rect.top) / (windowH + rect.height);
          const yOffset = (progress - 0.5) * 40; // subtle parallax
          img.style.transform = `translateY(${yOffset}px) scale(${img.classList.contains('group-hover:scale-[1.03]') ? 1 : 1})`;
        }
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  document.addEventListener('DOMContentLoaded', initParallax);
  document.addEventListener('astro:after-swap', initParallax);
</script>

<style>
  /* Shimmer line that sweeps across the image on hover */
  .image-shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(200, 255, 0, 0.06) 40%,
      rgba(255, 255, 255, 0.08) 50%,
      rgba(200, 255, 0, 0.06) 60%,
      transparent 100%
    );
    animation: image-shimmer-sweep 2s ease-in-out infinite;
  }

  @keyframes image-shimmer-sweep {
    0% { left: -60%; }
    100% { left: 120%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .image-shimmer {
      animation: none !important;
      display: none;
    }
  }
</style>
