---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

const aboutEntry = await getEntry('about', 'profile');
const { name, roles, stats } = aboutEntry?.data || { name: 'gae', roles: [], stats: { experience: '0', projects: '0' } };

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.PROD ? !data.draft : true;
})).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const latestPost = posts[0];

const techStack = [
  { name: 'TypeScript', icon: 'logos:typescript-icon' },
  { name: 'React', icon: 'logos:react' },
  { name: 'Next.js', icon: 'logos:nextjs-icon' },
  { name: 'Astro', icon: 'logos:astro-icon' },
  { name: 'Python', icon: 'logos:python' },
  { name: 'Go', icon: 'logos:go' },
  { name: 'Docker', icon: 'logos:docker-icon' },
  { name: 'Tailwind', icon: 'logos:tailwindcss-icon' },
];
---

<section id="bento" class="relative z-10 py-32 md:py-44 px-6">
  <div class="max-w-6xl mx-auto">

    <!-- Section Label -->
    <div class="flex items-center gap-6 mb-16 reveal-item">
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">
        Overview
      </span>
      <div class="flex-1 h-px bg-border-subtle"></div>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[280px]">

      <!-- 1: Latest Writing (Large) -->
      {latestPost ? (
        <a href={`/blog/${latestPost.slug}`}
           class="bento-card md:col-span-2 lg:col-span-2 row-span-1 md:row-span-2 reveal-item group relative overflow-hidden">
          <div class="absolute inset-0">
            {latestPost.data.cover && (
              <Image
                src={latestPost.data.cover}
                alt={latestPost.data.coverAlt || ""}
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 ease-out group-hover:scale-[1.04]"
              />
            )}
            <div class="absolute inset-0 bg-linear-to-t from-void via-void/60 to-transparent"></div>
          </div>
          <div class="absolute top-5 left-5 z-10">
            <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">Latest Article</span>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 z-10">
            <div class="flex items-center gap-3 mb-4">
              <span class="px-2.5 py-1 rounded-full bg-accent/10 border border-accent/20 text-accent text-[9px] font-mono uppercase tracking-wider">
                New
              </span>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl font-bold text-text-primary mb-2 leading-tight group-hover:text-accent transition-colors duration-300">
              {latestPost.data.title}
            </h3>
            <p class="text-sm text-text-secondary line-clamp-2 max-w-md">
              {latestPost.data.description}
            </p>
          </div>
          <div class="bento-card-glow"></div>
        </a>
      ) : (
        <div class="bento-card md:col-span-2 lg:col-span-2 row-span-1 md:row-span-2 reveal-item flex items-center justify-center">
          <span class="font-mono text-sm text-text-tertiary">No articles yet</span>
        </div>
      )}

      <!-- 2: Tech Stack -->
      <div class="bento-card reveal-item relative overflow-hidden group">
        <div class="absolute top-5 left-5 z-10">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">Stack</span>
        </div>
        <div class="p-6 pt-14 h-full flex flex-col justify-center">
          <div class="grid grid-cols-4 gap-5">
            {techStack.map((tech) => (
              <div class="flex flex-col items-center gap-2 group/icon" title={tech.name}>
                <div class="w-10 h-10 rounded-xl bg-void-elevated border border-border-subtle flex items-center justify-center group-hover/icon:border-accent/30 transition-all duration-300 group-hover/icon:scale-110">
                  <Icon name={tech.icon} class="w-5 h-5 grayscale group-hover/icon:grayscale-0 transition-all duration-300" />
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="bento-card-glow"></div>
      </div>

      <!-- 3: GitHub -->
      <a href="https://github.com/gae-22" target="_blank" rel="noopener noreferrer"
         class="bento-card reveal-item relative overflow-hidden group" aria-label="GitHub Profile">
        <div class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.03)_1px,transparent_1px)] bg-size-[16px_16px]"></div>
        <div class="absolute top-5 left-5 z-10">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">GitHub</span>
        </div>
        <div class="relative z-10 h-full flex flex-col items-center justify-center">
          <Icon name="lucide:github" class="w-12 h-12 text-text-primary mb-4 group-hover:text-accent group-hover:scale-110 transition-all duration-500" />
          <span class="font-heading font-bold text-lg text-text-primary">@gae-22</span>
          <span class="font-mono text-[10px] text-text-tertiary mt-1.5 uppercase tracking-wider">Open Source</span>
        </div>
        <!-- Arrow indicator -->
        <div class="absolute bottom-5 right-5 opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">
          <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </div>
        <div class="bento-card-glow"></div>
      </a>

      <!-- 4: Clock / Location -->
      <div class="bento-card reveal-item relative overflow-hidden group">
        <div class="absolute top-5 left-5 z-10">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">Location</span>
        </div>
        <div class="h-full flex flex-col items-center justify-center relative">
          <!-- Radial glow on hover -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
               style="background: radial-gradient(circle at 50% 50%, rgba(200,255,0,0.04), transparent 70%);">
          </div>
          <time class="bento-clock font-display text-4xl font-light tabular-nums tracking-wider text-text-primary relative z-10">
            --:--
          </time>
          <span class="font-mono text-[9px] mt-3 uppercase tracking-[0.25em] text-text-tertiary relative z-10">Tokyo, Japan</span>
          <!-- Seconds pulse -->
          <div class="absolute bottom-5 flex items-center gap-1.5">
            <div class="w-1.5 h-1.5 rounded-full bg-accent" style="animation: pulse-accent 2s ease-in-out infinite;"></div>
            <span class="font-mono text-[8px] uppercase tracking-[0.2em] text-text-tertiary">Live</span>
          </div>
        </div>
        <div class="bento-card-glow"></div>
      </div>

      <!-- 5: Stats -->
      <div class="bento-card reveal-item relative overflow-hidden group">
        <div class="absolute top-5 left-5 z-10">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">Stats</span>
        </div>
        <div class="h-full flex flex-col justify-center p-6 pt-14 gap-6">
          <div>
            <span class="font-display text-5xl font-bold text-text-primary tracking-tight">{stats.experience}+</span>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-secondary mt-1">Years Experience</p>
          </div>
          <div class="w-full h-px bg-border-subtle"></div>
          <div>
            <span class="font-display text-5xl font-bold text-accent tracking-tight">{stats.projects}</span>
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-secondary mt-1">Projects Built</p>
          </div>
        </div>
        <div class="bento-card-glow"></div>
      </div>

      <!-- 6: About Link -->
      <a href="/about" class="bento-card reveal-item relative overflow-hidden group" aria-label="About Me">
        <div class="absolute top-5 left-5 z-10">
          <span class="font-mono text-[9px] uppercase tracking-[0.2em] text-text-tertiary">Profile</span>
        </div>
        <div class="h-full flex flex-col items-start justify-end p-6">
          <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/20 flex items-center justify-center mb-4 group-hover:bg-accent/20 transition-colors duration-300">
            <Icon name="lucide:user" class="w-5 h-5 text-accent" />
          </div>
          <span class="font-heading text-xl font-bold text-text-primary group-hover:text-accent transition-colors duration-300">About Me</span>
          <p class="font-body text-xs text-text-secondary mt-1">Get to know the person behind the code.</p>
          <!-- Roles -->
          <div class="flex flex-wrap gap-1.5 mt-4">
            {roles.map((role: string) => (
              <span class="px-2.5 py-1 rounded-full border border-border-subtle font-mono text-[9px] uppercase tracking-wider text-text-tertiary group-hover:border-accent/20 group-hover:text-text-secondary transition-all duration-300">
                {role}
              </span>
            ))}
          </div>
        </div>
        <!-- Arrow indicator -->
        <div class="absolute bottom-5 right-5 opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">
          <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
        <div class="bento-card-glow"></div>
      </a>

    </div>

  </div>
</section>

<script>
  function initBentoClock() {
    const displays = document.querySelectorAll('.bento-clock');
    if (!displays.length) return;

    function update() {
      const now = new Date();
      const timeString = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Tokyo',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      }).format(now);
      displays.forEach(d => { d.textContent = timeString; });
    }

    update();
    setInterval(update, 1000);
  }

  document.addEventListener('DOMContentLoaded', initBentoClock);
  document.addEventListener('astro:after-swap', initBentoClock);
</script>
