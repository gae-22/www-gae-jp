---
import { getCollection, getEntry } from 'astro:content';
import BentoItem from './BentoItem.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Clock from './Clock.astro';

const aboutEntry = await getEntry('about', 'profile');
const { name, roles, stats } = aboutEntry?.data || { name: 'gae', roles: [], stats: { experience: '0', projects: '0' } };

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.PROD ? !data.draft : true;
})).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const latestPost = posts[0];

const techStack = [
  { name: 'TypeScript', icon: 'logos:typescript-icon' },
  { name: 'React', icon: 'logos:react' },
  { name: 'Next.js', icon: 'logos:nextjs-icon' },
  { name: 'Astro', icon: 'logos:astro-icon' },
  { name: 'Python', icon: 'logos:python' },
  { name: 'Go', icon: 'logos:go' },
  { name: 'Docker', icon: 'logos:docker-icon' },
  { name: 'Tailwind', icon: 'logos:tailwindcss-icon' },
];
---

<section id="work" class="max-w-7xl mx-auto px-6 py-20 relative z-10">

    <!-- Section Header -->
    <div class="flex items-end justify-between mb-12 reveal">
        <div class="relative">
            <span class="absolute -left-8 top-1 vertical-text text-[10px] font-mono tracking-widest text-zinc-300 hidden md:block opacity-50">
                WORKS
            </span>
            <h2 class="text-4xl lg:text-5xl font-heading font-bold text-zinc-900 tracking-tight leading-none">
                Selected <br/>
                <span class="text-zinc-400 font-serif italic font-light">Works & Thoughts</span>
            </h2>
        </div>
        <a href="/blog" class="hidden sm:flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-zinc-900 transition-colors group">
            View all posts
            <div class="bg-zinc-100 p-1.5 rounded-full group-hover:bg-zinc-200 transition-colors">
                <Icon name="lucide:arrow-right" class="w-4 h-4" />
            </div>
        </a>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 lg:auto-rows-[220px]">

        <!-- Item 1: Featured Post (Large) -->
        <BentoItem
            class="col-span-2 md:col-span-4 lg:col-span-4 row-span-2 reveal overflow-hidden group glass-card border-none ring-1 ring-zinc-900/5"
            title="Latest Writing"
            href={latestPost ? `/blog/${latestPost.slug}` : undefined}
        >
            <div class="w-full h-full relative z-10 bg-white/50 group-hover:bg-white/80 transition-colors">
                {latestPost ? (
                    <>
                        <div class="absolute inset-0 flex flex-col md:flex-row">
                            {latestPost.data.cover && (
                                <div class="w-full md:w-1/2 h-56 md:h-full relative overflow-hidden">
                                     <Image
                                        src={latestPost.data.cover}
                                        alt={latestPost.data.coverAlt || ""}
                                        class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
                                    />
                                    <div class="absolute inset-0 bg-zinc-900/5 group-hover:bg-transparent transition-colors duration-500"></div>
                                </div>
                            )}
                            <div class="w-full md:w-1/2 p-8 flex flex-col justify-center relative">
                                <!-- Deco -->
                                <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                    <Icon name="lucide:arrow-up-right" class="w-6 h-6 text-zinc-900" />
                                </div>

                                <div class="flex items-center gap-3 mb-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold text-emerald-700 bg-emerald-100/80 border border-emerald-200/50 backdrop-blur-sm">NEW</span>
                                    <span class="text-zinc-400 text-xs font-mono tracking-wide">
                                        {latestPost.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                                    </span>
                                </div>
                                <h3 class="text-2xl md:text-3xl lg:text-4xl font-heading font-bold leading-[1.1] text-zinc-900 mb-4 group-hover:text-primary transition-colors">
                                    {latestPost.data.title}
                                </h3>
                                <p class="text-sm md:text-base text-zinc-500 line-clamp-3 leading-relaxed text-balance">
                                    {latestPost.data.description}
                                </p>
                            </div>
                        </div>
                    </>
                ) : (
                    <div class="w-full h-full flex items-center justify-center text-zinc-400">
                        <p class="font-mono text-xs">No posts yet</p>
                    </div>
                )}
            </div>
        </BentoItem>

        <!-- Item 2: Clock -->
        <BentoItem class="col-span-1 row-span-1 reveal reveal-delay-1 glass-card border-none ring-1 ring-zinc-900/5 flex items-center justify-center">
            <Clock />
        </BentoItem>

        <!-- Item 3: GitHub -->
        <BentoItem class="col-span-1 row-span-1 group/gh reveal reveal-delay-2 bg-zinc-900 text-white ring-1 ring-zinc-900 shadow-xl shadow-zinc-900/10" href="https://github.com/gae-22" title="GitHub">
            <div class="p-6 flex flex-col justify-between h-full relative overflow-hidden">
                <div class="flex justify-between items-start z-10">
                    <Icon name="lucide:github" class="w-6 h-6" />
                    <Icon name="lucide:arrow-up-right" class="w-4 h-4 opacity-50 group-hover/gh:opacity-100 group-hover/gh:translate-x-0.5 group-hover/gh:-translate-y-0.5 transition-all" />
                </div>
                <div class="z-10">
                    <span class="text-base font-bold font-heading block">GitHub</span>
                    <span class="text-[10px] font-mono text-zinc-500">@gae-22</span>
                </div>
                <!-- Decoration -->
                <Icon name="lucide:github" class="absolute -bottom-4 -right-4 w-28 h-28 text-zinc-800 opacity-20 rotate-12 transition-transform duration-500 group-hover/gh:rotate-6 group-hover/gh:scale-110" />
            </div>
        </BentoItem>

        <!-- Item 4: Tech Stack Marquee -->
        <BentoItem class="col-span-2 row-span-1 overflow-hidden reveal reveal-delay-3 glass-card border-none ring-1 ring-zinc-900/5">
            <div class="flex flex-col h-full justify-center gap-5 py-4">
                 <div class="px-6 flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-accent-blue"></div>
                    <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Tech Stack</span>
                 </div>
                <div class="overflow-hidden relative group">
                    <div class="flex gap-4 marquee-track group-hover:[animation-play-state:paused]">
                        {[...techStack, ...techStack].map(tech => (
                            <div class="flex items-center gap-2 shrink-0 px-3.5 py-2 rounded-lg bg-white/50 backdrop-blur-sm shadow-sm ring-1 ring-zinc-900/5 hover:ring-zinc-900/10 transition-all">
                                <Icon name={tech.icon} class="w-4 h-4" />
                                <span class="text-xs font-medium text-zinc-700">{tech.name}</span>
                            </div>
                        ))}
                    </div>
                     <div class="absolute inset-y-0 left-0 w-12 bg-linear-to-r from-white/80 to-transparent z-10"></div>
                     <div class="absolute inset-y-0 right-0 w-12 bg-linear-to-l from-white/80 to-transparent z-10"></div>
                </div>
            </div>
        </BentoItem>

    </div>
</section>
