---
import { getCollection, getEntry } from 'astro:content';
import BentoItem from './BentoItem.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Clock from './Clock.astro';

const aboutEntry = await getEntry('about', 'profile');
const { name, roles, stats } = aboutEntry?.data || { name: 'gae', roles: [], stats: { experience: '0', projects: '0' } };

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.PROD ? !data.draft : true;
})).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const latestPost = posts[0];

const techStack = [
  { name: 'TypeScript', icon: 'logos:typescript-icon' },
  { name: 'React', icon: 'logos:react' },
  { name: 'Next.js', icon: 'logos:nextjs-icon' },
  { name: 'Astro', icon: 'logos:astro-icon' },
  { name: 'Python', icon: 'logos:python' },
  { name: 'Go', icon: 'logos:go' },
  { name: 'Docker', icon: 'logos:docker-icon' },
  { name: 'Tailwind', icon: 'logos:tailwindcss-icon' },
];
---

<section id="work" class="max-w-7xl mx-auto px-6 py-12">

    <!-- Section Header -->
    <div class="flex items-end justify-between mb-8 reveal">
        <div>
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 mb-1 block">Selected Works</span>
            <h2 class="text-3xl lg:text-4xl font-display font-bold text-zinc-900 tracking-tight">
                Craft & <span class="text-zinc-400 font-normal italic">Thinking</span>
            </h2>
        </div>
        <a href="/blog" class="hidden sm:flex items-center gap-2 text-xs font-medium text-zinc-500 hover:text-zinc-900 transition-colors">
            View all posts <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
        </a>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 auto-rows-[180px] lg:auto-rows-[200px]">

        <!-- Item 1: Featured Post (Large) -->
        <BentoItem
            class="col-span-2 md:col-span-4 lg:col-span-4 row-span-2 reveal overflow-hidden group"
            title="Latest Writing"
            href={latestPost ? `/blog/${latestPost.slug}` : undefined}
        >
            <div class="w-full h-full relative z-10 bg-zinc-100 group-hover:bg-zinc-50 transition-colors">
                {latestPost ? (
                    <>
                        <div class="absolute inset-0 flex flex-col md:flex-row">
                            {latestPost.data.cover && (
                                <div class="w-full md:w-1/2 h-48 md:h-full relative overflow-hidden">
                                     <Image
                                        src={latestPost.data.cover}
                                        alt={latestPost.data.coverAlt || ""}
                                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 grayscale group-hover:grayscale-0"
                                    />
                                    <div class="absolute inset-0 ring-1 ring-inset ring-black/5 md:hidden"></div>
                                </div>
                            )}
                            <div class="w-full md:w-1/2 p-6 md:p-8 flex flex-col justify-center">
                                <div class="flex items-center gap-2 mb-3">
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold text-emerald-700 bg-emerald-100 border border-emerald-200">NEW</span>
                                    <span class="text-zinc-400 text-xs font-mono">
                                        {latestPost.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                                    </span>
                                </div>
                                <h3 class="text-xl md:text-2xl lg:text-3xl font-display font-bold leading-tight text-zinc-900 mb-3 group-hover:text-blue-600 transition-colors">
                                    {latestPost.data.title}
                                </h3>
                                <p class="text-sm text-zinc-500 line-clamp-2 leading-relaxed">
                                    {latestPost.data.description}
                                </p>
                            </div>
                        </div>

                        <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white border border-zinc-200 flex items-center justify-center text-zinc-400 opacity-0 -translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 shadow-sm">
                            <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                        </div>
                    </>
                ) : (
                    <div class="w-full h-full flex items-center justify-center text-zinc-400">
                        <p class="font-mono text-xs">No posts yet</p>
                    </div>
                )}
            </div>
        </BentoItem>

        <!-- Item 2: Clock -->
        <BentoItem class="col-span-1 row-span-1 reveal reveal-delay-1 bg-white border border-zinc-200">
            <Clock />
        </BentoItem>

        <!-- Item 3: GitHub -->
        <BentoItem class="col-span-1 row-span-1 group/gh reveal reveal-delay-2 bg-zinc-900 text-white border border-zinc-900" href="https://github.com/gae-22" title="GitHub">
            <div class="p-5 flex flex-col justify-between h-full relative overflow-hidden">
                <Icon name="lucide:github" class="w-6 h-6 z-10" />
                <div class="z-10">
                    <span class="text-sm font-bold font-display block">GitHub</span>
                    <span class="text-[10px] font-mono text-zinc-400">@gae-22</span>
                </div>
                <!-- Decoration -->
                <Icon name="lucide:github" class="absolute -bottom-4 -right-4 w-24 h-24 text-zinc-800 opacity-20 rotate-12" />
            </div>
        </BentoItem>

        <!-- Item 4: Tech Stack Marquee -->
        <BentoItem class="col-span-2 row-span-1 overflow-hidden reveal reveal-delay-3 bg-zinc-50 border border-zinc-200">
            <div class="flex flex-col h-full justify-center gap-4 py-4">
                 <div class="px-5">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400">Tech Stack</span>
                 </div>
                <div class="overflow-hidden relative">
                    <div class="flex gap-4 marquee-track">
                        {[...techStack, ...techStack].map(tech => (
                            <div class="flex items-center gap-2 shrink-0 px-3 py-1.5 rounded-md border border-zinc-200 bg-white shadow-sm">
                                <Icon name={tech.icon} class="w-3.5 h-3.5" />
                                <span class="text-xs font-medium text-zinc-700">{tech.name}</span>
                            </div>
                        ))}
                    </div>
                     <div class="absolute inset-y-0 left-0 w-8 bg-linear-to-r from-zinc-50 to-transparent"></div>
                     <div class="absolute inset-y-0 right-0 w-8 bg-linear-to-l from-zinc-50 to-transparent"></div>
                </div>
            </div>
        </BentoItem>

        <!-- Item 5: Location -->
        <BentoItem class="col-span-2 md:col-span-2 row-span-1 overflow-hidden reveal reveal-delay-4 bg-white border border-zinc-200 group">
            <div class="p-5 flex items-center justify-between h-full relative">
                 <div class="absolute inset-0 bg-dot-pattern opacity-[0.4]"></div>

                <div class="relative z-10 flex flex-col justify-between h-full">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full w-fit">Base</span>
                    <div>
                        <span class="text-2xl font-bold font-display text-zinc-900 leading-none">Tokyo</span>
                        <span class="text-[10px] font-mono text-zinc-400 block mt-1">35.6762° N, 139.6503° E</span>
                    </div>
                </div>

                <div class="relative w-10 h-10 flex items-center justify-center z-10 group-hover:scale-110 transition-transform duration-300">
                     <span class="absolute inline-flex h-full w-full rounded-full opacity-20 animate-ping bg-blue-500"></span>
                    <div class="relative w-full h-full rounded-full flex items-center justify-center bg-blue-50 text-blue-600 border border-blue-100">
                        <Icon name="lucide:map-pin" class="w-4 h-4" />
                    </div>
                </div>
            </div>
        </BentoItem>

    </div>
</section>
