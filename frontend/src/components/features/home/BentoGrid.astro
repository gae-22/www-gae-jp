---
import { getCollection, getEntry } from 'astro:content';
import BentoItem from './BentoItem.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Clock from './Clock.astro';

const aboutEntry = await getEntry('about', 'profile');
const { name, roles, stats } = aboutEntry?.data || { name: 'gae', roles: [], stats: { experience: '0', projects: '0' } };

const posts = (await getCollection('blog', ({ data }) => {
	return import.meta.env.PROD ? !data.draft : true;
})).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const latestPost = posts[0];

const techStack = [
  { name: 'TypeScript', icon: 'logos:typescript-icon' },
  { name: 'React', icon: 'logos:react' },
  { name: 'Next.js', icon: 'logos:nextjs-icon' },
  { name: 'Astro', icon: 'logos:astro-icon' },
  { name: 'Python', icon: 'logos:python' },
  { name: 'Go', icon: 'logos:go' },
  { name: 'Docker', icon: 'logos:docker-icon' },
  { name: 'Tailwind', icon: 'logos:tailwindcss-icon' },
];
---

<section id="work" class="max-w-7xl mx-auto px-6 py-32 relative z-10">

    <!-- Section Header -->
    <div class="mb-20">
        <span class="text-accent-blue font-mono text-xs uppercase tracking-widest mb-4 block">Selected Works</span>
        <h2 class="text-display text-5xl md:text-7xl font-bold tracking-tighter text-zinc-900 mb-6">
            Craftsmanship <br class="hidden md:block" />
            <span class="text-zinc-400 font-serif italic font-light tracking-normal">& Engineering</span>
        </h2>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[300px]">

        <!-- Item 1: Latest Writing (Large) -->
        <BentoItem
            class="md:col-span-2 lg:col-span-2 row-span-1 md:row-span-2 reveal-item"
            title="Latest Writing"
            href={latestPost ? `/blog/${latestPost.slug}` : undefined}
        >
            <div class="w-full h-full relative group">
                {latestPost ? (
                    <>
                        <div class="absolute inset-0">
                            {latestPost.data.cover && (
                                <Image
                                    src={latestPost.data.cover}
                                    alt={latestPost.data.coverAlt || ""}
                                    class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out group-hover:scale-110 grayscale group-hover:grayscale-0 opacity-90"
                                />
                            )}
                             <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent"></div>
                        </div>

                        <div class="absolute bottom-0 left-0 p-8 w-full">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="px-2 py-1 rounded bg-white/20 backdrop-blur-md text-white/90 text-[10px] font-mono uppercase tracking-wider border border-white/10">
                                    New Article
                                </span>
                            </div>
                            <h3 class="text-3xl font-heading font-bold text-white mb-2 leading-tight group-hover:translate-x-2 transition-transform duration-300">
                                {latestPost.data.title}
                            </h3>
                            <p class="text-zinc-300 text-sm line-clamp-2 max-w-md group-hover:text-white transition-colors">
                                {latestPost.data.description}
                            </p>
                        </div>
                    </>
                ) : (
                    <div class="p-10 text-zinc-400 flex items-center justify-center h-full">No posts yet</div>
                )}
            </div>
        </BentoItem>


        <!-- Item 2: Tech Stack -->
        <BentoItem class="md:col-span-1 lg:col-span-1 row-span-1 reveal-item" title="Stack">
             <div class="p-6 h-full flex flex-col justify-center">
                <div class="grid grid-cols-4 gap-4">
                    {techStack.map(tech => (
                        <div class="flex flex-col items-center justify-center gap-2 group/icon" title={tech.name}>
                            <Icon name={tech.icon} class="w-8 h-8 grayscale group-hover/icon:grayscale-0 transition-all duration-300 group-hover/icon:scale-110" />
                        </div>
                    ))}
                </div>
            </div>
        </BentoItem>

        <!-- Item 3: GitHub -->
        <BentoItem
            class="md:col-span-1 lg:col-span-1 row-span-1 reveal-item bg-zinc-900 border-none group"
            href="https://github.com/gae-22"
        >
            <div class="relative h-full w-full flex flex-col items-center justify-center p-6 bg-zinc-950 text-white overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(#333_1px,transparent_1px)] bg-size-[16px_16px] opacity-20"></div>
                <Icon name="lucide:github" class="w-12 h-12 mb-4 relative z-10 group-hover:scale-110 transition-transform duration-300" />
                <span class="font-heading font-bold text-xl relative z-10">GitHub</span>
                <span class="text-xs text-zinc-500 font-mono mt-1 relative z-10">@gae-22</span>

                <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-white/5 rounded-full blur-2xl group-hover:bg-accent-violet/20 transition-colors duration-500"></div>
            </div>
        </BentoItem>

         <!-- Item 4: Clock / Location -->
        <BentoItem class="md:col-span-1 lg:col-span-1 row-span-1 reveal-item grid place-items-center bg-white">
            <Clock />
        </BentoItem>

        <!-- Item 5: About Link -->
        <BentoItem
            class="md:col-span-1 lg:col-span-1 row-span-1 reveal-item bg-accent-blue/5 border-accent-blue/10"
            href="/about"
            title="Profile"
        >
            <div class="p-6 h-full flex flex-col justify-between group">
                <div class="w-10 h-10 rounded-full bg-accent-blue/10 text-accent-blue flex items-center justify-center">
                    <Icon name="lucide:user" class="w-5 h-5" />
                </div>
                <div>
                    <span class="text-lg font-bold text-zinc-900 group-hover:text-accent-blue transition-colors">About Me</span>
                    <p class="text-xs text-zinc-500 mt-1">Get to know the person behind the code.</p>
                </div>
            </div>
        </BentoItem>

    </div>
</section>
