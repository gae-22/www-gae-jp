---
/**
 * AmbientBackground — Continuously moving ambient gradient orbs.
 * Creates subtle, slow-moving color blobs that drift across the viewport
 * giving the page a "living, breathing" feeling even when idle.
 *
 * Always visible behind content. Pure CSS — no JS required.
 */
---

<div class="ambient-bg" aria-hidden="true">
  <!-- Primary accent orb — slow diagonal drift -->
  <div class="ambient-orb ambient-orb-1"></div>
  <!-- Secondary orb — opposite drift, dimmer -->
  <div class="ambient-orb ambient-orb-2"></div>
  <!-- Tertiary orb — vertical slow pulse -->
  <div class="ambient-orb ambient-orb-3"></div>
</div>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    will-change: transform, opacity;
  }

  /* ── Orb 1: Acid lime accent, large, slow diagonal drift ── */
  .ambient-orb-1 {
    width: clamp(300px, 40vw, 600px);
    height: clamp(300px, 40vw, 600px);
    background: radial-gradient(circle, rgba(200, 255, 0, 0.06) 0%, transparent 70%);
    top: -10%;
    left: -10%;
    animation: orb-drift-1 25s ease-in-out infinite alternate;
  }

  /* ── Orb 2: Cool white/blue tint, medium, reverse drift ── */
  .ambient-orb-2 {
    width: clamp(250px, 35vw, 500px);
    height: clamp(250px, 35vw, 500px);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
    bottom: -10%;
    right: -10%;
    animation: orb-drift-2 30s ease-in-out infinite alternate;
  }

  /* ── Orb 3: Subtle accent, small, vertical breathe ── */
  .ambient-orb-3 {
    width: clamp(200px, 25vw, 400px);
    height: clamp(200px, 25vw, 400px);
    background: radial-gradient(circle, rgba(200, 255, 0, 0.035) 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: orb-breathe 20s ease-in-out infinite;
  }

  /* ── Keyframes ── */
  @keyframes orb-drift-1 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.6;
    }
    25% {
      opacity: 0.8;
    }
    50% {
      transform: translate(30vw, 40vh) scale(1.15);
      opacity: 0.5;
    }
    75% {
      opacity: 0.9;
    }
    100% {
      transform: translate(15vw, 80vh) scale(0.9);
      opacity: 0.6;
    }
  }

  @keyframes orb-drift-2 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.5;
    }
    33% {
      transform: translate(-25vw, -30vh) scale(1.1);
      opacity: 0.7;
    }
    66% {
      transform: translate(-40vw, -10vh) scale(0.95);
      opacity: 0.4;
    }
    100% {
      transform: translate(-15vw, -50vh) scale(1.05);
      opacity: 0.6;
    }
  }

  @keyframes orb-breathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.4;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0.7;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .ambient-orb {
      animation: none !important;
    }
  }
</style>
