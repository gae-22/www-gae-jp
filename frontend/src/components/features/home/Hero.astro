---
const currentYear = new Date().getFullYear();
---

<section id="hero" class="relative min-h-svh flex flex-col items-center justify-center px-6 overflow-hidden">

  <!-- Subtle animated grid lines background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Vertical grid lines with shimmer -->
    <div class="hero-grid-line absolute left-[20%] top-0 bottom-0 w-px bg-border-subtle opacity-30" style="--shimmer-delay: 0s;"></div>
    <div class="hero-grid-line absolute left-[40%] top-0 bottom-0 w-px bg-border-subtle opacity-20" style="--shimmer-delay: 2s;"></div>
    <div class="hero-grid-line absolute left-[60%] top-0 bottom-0 w-px bg-border-subtle opacity-20" style="--shimmer-delay: 4s;"></div>
    <div class="hero-grid-line absolute left-[80%] top-0 bottom-0 w-px bg-border-subtle opacity-30" style="--shimmer-delay: 6s;"></div>

    <!-- Horizontal scanning line — a faint line that slowly sweeps down -->
    <div class="hero-scan-line absolute left-0 right-0 h-px bg-accent/4"></div>
  </div>

  <!-- Hero Headlines -->
  <div class="relative z-10 flex flex-col items-start w-full max-w-7xl">

    <!-- Top meta line -->
    <div class="fade-up mb-12 md:mb-16 flex items-center gap-6" style="animation-delay: 0.3s;">
      <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.3em] text-text-tertiary">Portfolio {currentYear}</span>
      <span class="w-12 h-px bg-border-hover"></span>
    </div>

    <div class="hero-lines" aria-label="gae Software Engineer">
      <div class="hero-line overflow-hidden">
        <h1 class="text-display text-[clamp(3.5rem,13vw,11rem)] font-extrabold text-text-primary leading-[0.85] tracking-[-0.04em]">
          gae
        </h1>
      </div>
      <div class="hero-line overflow-hidden">
        <h1 class="text-display text-[clamp(3.5rem,13vw,11rem)] font-extralight text-text-secondary leading-[0.85] tracking-[-0.04em]">
          Software
        </h1>
      </div>
      <div class="hero-line overflow-hidden">
        <h1 class="text-display text-[clamp(3.5rem,13vw,11rem)] font-extrabold text-text-primary leading-[0.85] tracking-[-0.04em] flex items-center gap-4">
          Engineer
          <!-- Available indicator per spec -->
          <span class="inline-flex items-center gap-2 ml-4">
            <span class="inline-block w-2 h-2 rounded-full bg-accent" style="animation: pulse-accent 2s ease-in-out infinite;" aria-hidden="true"></span>
            <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.3em] text-accent leading-none">Available</span>
          </span>
        </h1>
      </div>
    </div>

    <!-- Sub copy -->
    <div class="mt-10 md:mt-14">
      <p class="fade-up font-mono text-[10px] md:text-[11px] uppercase tracking-[0.2em] text-text-secondary" style="animation-delay: 1.3s;">
        Based in Tokyo — Crafting digital experiences
      </p>
    </div>

  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 fade-up" style="animation-delay: 2s;">
    <span class="font-mono text-[8px] uppercase tracking-[0.3em] text-text-tertiary">Scroll</span>
    <div class="w-px h-8 bg-text-tertiary origin-top" style="animation: scroll-bounce 2.5s ease-in-out infinite;"></div>
  </div>

  <!-- Bottom line separator -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-border-subtle"></div>

</section>

<style>
  /* Grid line shimmer — a bright spot slowly travels down each line */
  .hero-grid-line {
    overflow: hidden;
  }
  .hero-grid-line::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 80px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(200, 255, 0, 0.12) 50%,
      transparent 100%
    );
    animation: grid-shimmer 8s ease-in-out infinite;
    animation-delay: var(--shimmer-delay, 0s);
  }

  /* Horizontal scanning line — sweeps down continuously */
  .hero-scan-line {
    animation: scan-line 12s linear infinite;
  }

  @keyframes grid-shimmer {
    0%, 100% {
      top: -80px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: calc(100% + 80px);
      opacity: 0;
    }
  }

  @keyframes scan-line {
    0% {
      top: -1px;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    95% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid-line::after,
    .hero-scan-line {
      animation: none !important;
      opacity: 0 !important;
    }
  }
</style>
