---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden selection:bg-primary selection:text-white">
    <!-- Background Decor -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-linear-to-l from-zinc-50 to-transparent -z-10"></div>
    <div class="absolute top-20 right-20 w-64 h-64 bg-accent-blue/5 rounded-full blur-3xl -z-10 animate-pulse"></div>

    <div class="max-w-7xl mx-auto px-6 relative">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">

            <!-- Left: Main Content -->
            <div class="lg:col-span-7 flex flex-col items-start text-left space-y-8 reveal relative z-10">

                <!-- Vertical Text Decoration (Japanese Aesthetic) -->
                <div class="absolute -left-12 top-0 hidden xl:flex flex-col gap-4 opacity-30 select-none">
                    <span class="vertical-text font-heading font-bold text-xs tracking-[0.2em] text-zinc-900">
                        デジタル・リアリティ
                    </span>
                    <div class="h-16 w-px bg-zinc-300 mx-auto"></div>
                    <span class="vertical-text font-heading font-bold text-xs tracking-[0.2em] text-zinc-400">
                         二千二十六年
                    </span>
                </div>

                <!-- Status Badge -->
                <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-white border border-zinc-200 shadow-sm transition-transform hover:scale-105">
                    <span class="relative flex h-2.5 w-2.5">
                        <span class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-ping bg-emerald-500"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    <span class="text-[11px] font-mono font-medium tracking-wider uppercase text-zinc-600">Available for 2026</span>
                </div>

                <!-- Headline -->
                <h1 class="font-heading font-bold leading-[0.95] tracking-tight text-zinc-900"
                    style="font-size: clamp(3.5rem, 9vw, 7.5rem);">
                    <span class="block text-transparent bg-clip-text bg-linear-to-br from-zinc-900 to-zinc-600">Digital</span>
                    <span class="block relative">
                        Reality
                        <span class="text-accent text-3xl align-top font-mono tracking-tighter">.</span>
                    </span>
                </h1>

                <!-- Subheadline -->
                <p class="text-lg md:text-xl leading-relaxed text-zinc-500 max-w-lg text-balance font-medium">
                    Founding Software Engineer based in Tokyo. <br/>
                    Crafting <span class="text-zinc-900 font-semibold under">high-fidelity</span> web experiences with precision and aesthetic purity.
                </p>

                <!-- CTAs -->
                <div class="flex flex-wrap gap-4 pt-4">
                    <a href="#work" class="group relative px-7 py-3.5 rounded-full bg-zinc-900 text-white font-medium text-sm overflow-hidden flex items-center gap-2 shadow-lg shadow-zinc-900/20 hover:shadow-xl hover:shadow-zinc-900/30 transition-all hover:-translate-y-0.5">
                        <span class="relative z-10">Selected Work</span>
                        <Icon name="lucide:arrow-down-right" class="w-4 h-4 relative z-10 group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-transform" />
                        <div class="absolute inset-0 bg-zinc-800 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                    </a>
                    <a href="/about" class="group px-7 py-3.5 rounded-full border border-zinc-200 bg-white text-zinc-600 font-medium text-sm hover:text-zinc-900 hover:border-zinc-300 transition-all flex items-center gap-2 hover:bg-zinc-50">
                        About Me
                    </a>
                </div>
            </div>

            <!-- Right: Abstract Visual / Mini Bento -->
            <div class="lg:col-span-5 w-full lg:pl-12 reveal reveal-delay-2 relative">
                <!-- Decorative Circle -->
                <div class="absolute -top-12 -right-12 w-64 h-64 bg-linear-to-br from-zinc-100 to-zinc-50 rounded-full blur-2xl -z-10 opacity-60"></div>

                <div class="grid grid-cols-2 gap-4 rotate-3 hover:rotate-0 transition-transform duration-700 ease-out">
                    <!-- Tech Stack Card -->
                    <div class="col-span-2 p-6 rounded-3xl glass-card aspect-2/1 flex flex-col justify-between group">
                        <div class="flex justify-between items-start">
                             <div class="p-2 rounded-xl bg-zinc-50 text-zinc-400 group-hover:text-zinc-900 transition-colors">
                                <Icon name="lucide:layers" class="w-5 h-5" />
                             </div>
                             <span class="text-[10px] font-mono text-zinc-400 tracking-widest">STACK</span>
                        </div>
                        <div class="flex gap-4 text-zinc-400 group-hover:text-zinc-900 transition-colors">
                             <Icon name="logos:typescript-icon" class="w-7 h-7" />
                             <Icon name="logos:react" class="w-7 h-7" />
                             <Icon name="logos:nextjs-icon" class="w-7 h-7" />
                             <Icon name="logos:astro-icon" class="w-7 h-7" />
                        </div>
                    </div>

                    <!-- Location Card -->
                    <div class="p-6 rounded-3xl bg-zinc-900 text-white aspect-square flex flex-col justify-between shadow-2xl shadow-zinc-900/10 group hover:scale-[1.02] transition-transform">
                         <div class="flex justify-between items-start">
                             <Icon name="lucide:map-pinned" class="w-5 h-5 text-zinc-500 group-hover:text-white transition-colors" />
                        </div>
                        <div>
                             <span class="block text-3xl font-bold font-heading">JP</span>
                             <span class="text-xs text-zinc-500 font-mono group-hover:text-zinc-300 transition-colors">Tokyo, Minato</span>
                        </div>
                    </div>

                    <!-- Experience Card -->
                    <div class="p-6 rounded-3xl glass-card aspect-square flex flex-col justify-between group">
                        <div class="flex justify-between items-start">
                             <div class="p-2 rounded-xl bg-zinc-50 text-zinc-400 group-hover:text-accent transition-colors">
                                <Icon name="lucide:verified" class="w-5 h-5" />
                             </div>
                        </div>
                         <div>
                             <span class="block text-3xl font-bold font-heading group-hover:text-zinc-900 transition-colors">4+</span>
                             <span class="text-xs text-zinc-400 font-mono">Years Exp.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
