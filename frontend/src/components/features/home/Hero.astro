---
import { Icon } from 'astro-icon/components';


---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">

    <div class="max-w-7xl mx-auto px-6 w-full relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">

            <!-- Left: Typography & Intro -->
            <div class="lg:col-span-8 flex flex-col items-start space-y-8">

                <!-- Badge -->
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-200 bg-white/50 backdrop-blur-md">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-violet opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-violet"></span>
                    </span>
                    <span class="text-[10px] font-mono font-medium tracking-widest uppercase text-zinc-500">
                        Available for hire
                    </span>
                </div>

                <!-- Headline -->
                <h1 class="text-display text-6xl md:text-8xl lg:text-9xl font-bold tracking-tighter text-text-primary leading-[0.9]">
                    <span class="block hover:translate-x-4 transition-transform duration-500 ease-out cursor-default">Digital</span>
                    <span class="block text-gradient hover:translate-x-4 transition-transform duration-500 ease-out delay-75 cursor-default">Reality</span>
                    <span class="block hover:translate-x-4 transition-transform duration-500 ease-out delay-150 cursor-default">Crafter.</span>
                </h1>

                <!-- Description -->
                <p class="text-lg md:text-xl text-text-secondary max-w-xl leading-relaxed text-balance">
                    Founding Software Engineer based in Tokyo. <br/>
                    Obsessed with <span class="text-accent-violet font-semibold">performance</span>,
                    <span class="text-accent-cyan font-semibold">aesthetics</span>, and
                    <span class="text-accent-lime font-semibold">interaction</span>.
                </p>

                <!-- CTAs -->
                <div class="flex flex-wrap gap-4 pt-4">
                    <a href="#work" class="group relative px-8 py-4 rounded-full bg-text-primary text-white font-medium text-sm overflow-hidden flex items-center gap-2 shadow-lg shadow-indigo-500/20 hover:shadow-indigo-500/40 transition-all hover:-translate-y-1">
                        <span class="relative z-10 group-hover:px-2 transition-all duration-300">View Work</span>
                        <Icon name="lucide:arrow-down" class="w-4 h-4 relative z-10 transition-transform group-hover:translate-y-1" />
                        <div class="absolute inset-0 bg-accent-blue translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></div>
                    </a>

                    <a href="/about" class="px-8 py-4 rounded-full border border-zinc-200 bg-white/40 backdrop-blur-sm text-text-secondary font-medium text-sm hover:bg-white hover:text-text-primary hover:border-zinc-300 transition-all hover:-translate-y-1">
                        More About Me
                    </a>
                </div>

            </div>

            <!-- Right: Visual / 3D Element -->
            <div class="lg:col-span-4 relative hidden lg:block perspective-1000">
                <div class="relative w-full aspect-4/5 preserve-3d group">

                    <!-- Floating Cards Concept -->
                     <div class="absolute top-10 right-0 w-64 h-80 glass-card p-6 flex flex-col justify-between rotate-6 group-hover:rotate-12 transition-transform duration-700 ease-out z-10">
                        <div class="flex justify-between items-start">
                             <Icon name="logos:react" class="w-10 h-10" />
                             <span class="font-mono text-xs text-zinc-400">01</span>
                        </div>
                        <div>
                            <span class="block text-3xl font-bold font-heading">React</span>
                            <span class="text-xs text-zinc-500">Component Architecture</span>
                        </div>
                     </div>

                     <div class="absolute top-20 right-20 w-64 h-80 glass-card bg-white/90 p-6 flex flex-col justify-between -rotate-3 group-hover:-rotate-6 transition-transform duration-700 ease-out z-20 shadow-2xl">
                        <div class="flex justify-between items-start">
                             <Icon name="logos:typescript-icon" class="w-10 h-10" />
                             <span class="font-mono text-xs text-zinc-400">02</span>
                        </div>
                        <div>
                            <span class="block text-3xl font-bold font-heading">Type<br/>Script</span>
                            <span class="text-xs text-zinc-500">Type Safety First</span>
                        </div>
                     </div>

                     <div class="absolute top-0 right-10 w-20 h-20 rounded-full bg-accent-lime/20 blur-xl animate-pulse pointer-events-none"></div>

                </div>
            </div>

        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
        <span class="text-[10px] uppercase tracking-widest font-mono">Scroll</span>
        <Icon name="lucide:arrow-down" class="w-4 h-4" />
    </div>

</section>
