---
import { Icon } from 'astro-icon/components';
---

<section class="relative pt-24 pb-12 flex flex-col items-center justify-center px-6 overflow-hidden">

    <!-- Hero Content -->
    <div class="relative z-10 max-w-5xl mx-auto text-center space-y-4">

        <!-- Status Badge - Minimal -->
        <div class="reveal flex justify-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100/80 border border-zinc-200 backdrop-blur-sm transition-all duration-300 hover:bg-zinc-200/80">
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-ping bg-emerald-500"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span class="text-[10px] font-mono font-medium tracking-wider uppercase text-zinc-500">Open to Work</span>
            </div>
        </div>

        <!-- Main Title — Massive & Tight -->
        <div class="reveal reveal-delay-1 perspective-[1000px]">
            <h1 class="font-display font-black leading-[0.85] tracking-tighter"
                style="font-size: clamp(4rem, 14vw, 11rem); color: var(--color-text);">
                <span class="block">Digital</span>
                <span class="block text-zinc-300/50" style="font-weight: 200;">Reality</span>
                <span class="text-gradient block">Crafter.</span>
            </h1>
        </div>

        <!-- Description -->
        <div class="reveal reveal-delay-2 max-w-xl mx-auto pt-2">
            <p class="text-base md:text-lg font-medium leading-relaxed text-balance text-zinc-500">
                Founding Software Engineer based in Tokyo.
                <span class="block mt-1 opacity-60 font-light">
                    Blending logic with aesthetic perfection.
                </span>
            </p>
        </div>

        <!-- CTAs - Compact -->
        <div class="reveal reveal-delay-3 flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
            <a href="#work" class="group relative px-6 py-3 rounded-full font-medium text-sm text-white bg-zinc-900 overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-lg">
                <span class="relative z-10 flex items-center gap-2">
                    View Work
                    <Icon name="lucide:arrow-down" class="w-3.5 h-3.5 group-hover:translate-y-0.5 transition-transform" />
                </span>
            </a>

            <a href="/about" class="group px-6 py-3 rounded-full text-sm font-medium text-zinc-600 hover:text-zinc-900 transition-colors flex items-center gap-2">
                Learn More
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" />
            </a>
        </div>
    </div>



</section>
