---
import { Icon } from 'astro-icon/components';
---

<section class="relative min-h-svh flex flex-col items-center justify-center px-6 overflow-hidden">

    <!-- Hero Content -->
    <div class="relative z-10 max-w-5xl mx-auto text-center space-y-10">

        <!-- Status Badge -->
        <div class="reveal flex justify-center">
            <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-2xl text-xs font-mono font-medium tracking-[0.15em] uppercase transition-all duration-300"
                 style={`border: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-surface) 70%, transparent); backdrop-filter: blur(12px); color: var(--color-text-muted);`}>
                <span class="relative flex h-2 w-2">
                    <span class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-ping" style="background: var(--color-accent-2);"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2" style="background: var(--color-accent-2);"></span>
                </span>
                Open to Work
            </div>
        </div>

        <!-- Main Title — Fluid Typography -->
        <div class="reveal reveal-delay-1 perspective-[1000px]">
            <h1 class="font-display font-extrabold leading-[0.9] tracking-[-0.04em]"
                style="font-size: clamp(3.5rem, 10vw, 9rem); color: var(--color-text);">
                <span class="text-split block" data-text="Digital">Digital</span>
                <span class="block italic font-extralight opacity-50" style="font-size: 0.85em;">Reality</span>
                <span class="text-gradient block">Crafter.</span>
            </h1>
        </div>

        <!-- Description -->
        <div class="reveal reveal-delay-2 max-w-2xl mx-auto">
            <p class="text-base md:text-lg leading-relaxed text-balance" style={`color: var(--color-text-muted);`}>
                東京を拠点とするソフトウェアエンジニア。<br>
                <span class="opacity-60">
                    論理的なコードと感性的なデザインを融合し、<br class="hidden md:block">
                    心地よいデジタル体験を実装する。
                </span>
            </p>
        </div>

        <!-- CTAs -->
        <div class="reveal reveal-delay-3 flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="#work" class="group relative px-8 py-4 rounded-2xl font-medium text-sm text-white overflow-hidden transition-all duration-400 hover:shadow-[0_0_40px_rgba(99,102,241,0.3)] hover-target"
               style={`background: var(--color-accent);`}>
                <span class="relative z-10 flex items-center gap-2.5">
                    View Work
                    <Icon name="lucide:arrow-down" class="w-4 h-4 group-hover:translate-y-1 transition-transform duration-300" />
                </span>
                <div class="absolute inset-0 bg-linear-to-r from-accent to-accent-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </a>

            <a href="/about" class="group text-sm font-medium flex items-center gap-2 transition-all duration-300 hover-target"
               style={`color: var(--color-text-muted);`}>
                <span class="relative">
                    Learn More
                    <span class="absolute -bottom-0.5 left-0 w-full h-px transition-transform duration-400 origin-left scale-x-0 group-hover:scale-x-100" style={`background: var(--color-accent);`}></span>
                </span>
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 -translate-x-1 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300" />
            </a>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 reveal reveal-delay-4">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] opacity-30" style={`color: var(--color-text);`}>Scroll</span>
        <div class="w-px h-10 overflow-hidden">
            <div class="w-full h-full animate-bounce" style={`background: linear-gradient(to bottom, var(--color-accent), transparent);`}></div>
        </div>
    </div>

</section>
