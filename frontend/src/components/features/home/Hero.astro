---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
---

<section class="relative pt-32 pb-16 lg:pt-48 lg:pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-start">

            <!-- Left: Main Content -->
            <div class="lg:col-span-7 flex flex-col items-start text-left space-y-6 reveal">

                <!-- Status Badge -->
                <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-zinc-100 border border-zinc-200/80">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full rounded-full opacity-75 animate-ping bg-emerald-500"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
                    <span class="text-[10px] font-mono font-medium tracking-wide uppercase text-zinc-500">Open to Work</span>
                </div>

                <!-- Headline -->
                <h1 class="font-display font-bold leading-[0.9] tracking-tighter text-zinc-900"
                    style="font-size: clamp(3.5rem, 8vw, 6.5rem);">
                    Digital <br />
                    <span class="text-zinc-400">Reality.</span>
                </h1>

                <!-- Subheadline -->
                <p class="text-lg md:text-xl font-medium leading-relaxed text-zinc-500 max-w-lg text-balance">
                    Founding Software Engineer based in Tokyo. <br/>
                    I build high-performance web applications with a focus on <span class="text-zinc-900">clinical precision</span> and <span class="text-zinc-900">aesthetic purity</span>.
                </p>

                <!-- CTAs -->
                <div class="flex flex-wrap gap-4 pt-2">
                    <a href="#work" class="group px-6 py-2.5 rounded-lg bg-zinc-900 text-white font-medium text-sm transition-all hover:bg-zinc-800 hover:shadow-lg hover:shadow-zinc-900/20 flex items-center gap-2">
                        View Selected Work
                        <Icon name="lucide:arrow-down" class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" />
                    </a>
                    <a href="/about" class="group px-6 py-2.5 rounded-lg border border-zinc-200 text-zinc-600 font-medium text-sm hover:text-zinc-900 hover:bg-zinc-50 transition-all flex items-center gap-2">
                        More About Me
                        <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                    </a>
                </div>
            </div>

            <!-- Right: Mini Bento / Visual -->
            <div class="lg:col-span-5 w-full reveal reveal-delay-2">
                <div class="grid grid-cols-2 gap-3">
                    <!-- Tech Stack Card -->
                    <div class="col-span-2 p-5 rounded-2xl bg-zinc-50 border border-zinc-200/60 aspect-2/1 flex flex-col justify-between hover:border-zinc-300 transition-colors">
                        <div class="flex justify-between items-start">
                             <Icon name="lucide:code-2" class="w-5 h-5 text-zinc-400" />
                             <span class="text-[10px] font-mono text-zinc-400">STACK</span>
                        </div>
                        <div class="flex gap-3 text-zinc-900">
                             <Icon name="logos:typescript-icon" class="w-6 h-6 grayscale hover:grayscale-0 transition-all cursor-help" />
                             <Icon name="logos:react" class="w-6 h-6 grayscale hover:grayscale-0 transition-all cursor-help" />
                             <Icon name="logos:nextjs-icon" class="w-6 h-6 grayscale hover:grayscale-0 transition-all cursor-help" />
                             <Icon name="logos:astro-icon" class="w-6 h-6 grayscale hover:grayscale-0 transition-all cursor-help" />
                        </div>
                    </div>

                    <!-- Location Card -->
                    <div class="p-5 rounded-2xl bg-white border border-zinc-200/60 aspect-square flex flex-col justify-between shadow-sm hover:shadow-md transition-all">
                         <div class="flex justify-between items-start">
                             <Icon name="lucide:map-pin" class="w-5 h-5 text-zinc-400" />
                        </div>
                        <div>
                             <span class="block text-2xl font-bold font-display text-zinc-900">JP</span>
                             <span class="text-xs text-zinc-500 font-mono">Tokyo</span>
                        </div>
                    </div>

                    <!-- Experience Card -->
                    <div class="p-5 rounded-2xl bg-zinc-900 text-white aspect-square flex flex-col justify-between shadow-lg shadow-zinc-900/10 hover:scale-[1.02] transition-transform">
                        <div class="flex justify-between items-start">
                             <Icon name="lucide:briefcase" class="w-5 h-5 text-zinc-500" />
                        </div>
                         <div>
                             <span class="block text-2xl font-bold font-display">4+</span>
                             <span class="text-xs text-zinc-400 font-mono">Years Exp.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
