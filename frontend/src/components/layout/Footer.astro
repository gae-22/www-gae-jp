---
const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-6 py-12 flex flex-col sm:flex-row items-center justify-between gap-6">

    <!-- Left -->
    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-tertiary">
      &copy; {year} gae
    </p>

    <!-- Right -->
    <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-text-tertiary">
      Designed in Tokyo
    </p>

  </div>
</footer>
