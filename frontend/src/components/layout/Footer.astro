---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/gae-22', icon: 'lucide:github' },
  { label: 'Discord', href: 'https://discord.gg/nqsegJHjBb', icon: 'simple-icons:discord' },
];
---

<footer class="mt-20 py-10 flex items-center justify-center relative z-10">
  <div class="flex items-center gap-6 px-6 py-3 rounded-full border border-white/20 bg-white/50 backdrop-blur-md shadow-lg shadow-zinc-900/5 hover:bg-white/70 transition-colors">

      <!-- Copyright -->
      <span class="text-[10px] font-mono font-medium text-zinc-400 tracking-wider">
          © {year} gae.
      </span>

      <div class="w-px h-3 bg-zinc-300"></div>

      <!-- Socials -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="text-zinc-400 hover:text-zinc-900 transition-colors transform hover:scale-110 duration-200"
          >
            <Icon name={link.icon} class="w-4 h-4" />
          </a>
        ))}
      </div>

  </div>
</footer>
