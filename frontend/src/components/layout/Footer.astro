---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/gae-22', icon: 'lucide:github' },
  { label: 'Discord', href: 'https://discord.gg/nqsegJHjBb', icon: 'simple-icons:discord' },
];

const marqueeText = 'AVAILABLE FOR WORK · LET\'S COLLABORATE · TOKYO, JAPAN · ';
---

<footer class="mt-12 py-8 flex items-center justify-center">
  <div class="flex items-center gap-6 px-5 py-2.5 rounded-full border border-zinc-100 bg-zinc-50/50 backdrop-blur-sm">

      <!-- Copyright -->
      <span class="text-[10px] font-mono font-medium text-zinc-400">
          © {year} gae.
      </span>

      <div class="w-px h-3 bg-zinc-200"></div>

      <!-- Socials -->
      <div class="flex items-center gap-3">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="text-zinc-400 hover:text-zinc-900 transition-colors"
          >
            <Icon name={link.icon} class="w-3.5 h-3.5" />
          </a>
        ))}
      </div>

  </div>
</footer>
