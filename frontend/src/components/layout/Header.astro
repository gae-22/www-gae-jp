---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Work', href: '/', },
  { label: 'Blog', href: '/blog', },
  { label: 'Projects', href: '/projects', },
  { label: 'About', href: '/about', },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40 pointer-events-none" id="site-header">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="pointer-events-auto group flex items-center gap-3 hover-target" transition:persist>
      <div class="w-9 h-9 rounded-xl overflow-hidden flex items-center justify-center border transition-all duration-300 group-hover:scale-110 group-hover:shadow-lg"
           style={`border-color: var(--color-border); background: var(--color-surface);`}>
        <img src="/gae.svg" alt="gae" class="w-5 h-5" />
      </div>
      <span class="text-sm font-display font-semibold tracking-tight hidden sm:block transition-colors duration-300"
            style={`color: var(--color-text);`}>
        gae
      </span>
    </a>

    <!-- Center Nav Pill -->
    <nav class="pointer-events-auto px-1.5 py-1.5 rounded-2xl transition-all duration-500 flex items-center gap-0.5" id="site-nav"
         style={`background: color-mix(in srgb, var(--color-surface) 60%, transparent); backdrop-filter: blur(24px) saturate(1.8); border: 1px solid var(--color-border-subtle);`}>
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "relative px-4 py-2 rounded-xl text-sm font-medium transition-all duration-300 magnetic-link hover-target",
              isActive ? "active-nav" : ""
            ]}
            style={isActive
              ? `color: white; background: var(--color-accent);`
              : `color: var(--color-text-muted);`
            }
            data-magnetic
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Actions -->
    <div class="pointer-events-auto flex items-center gap-2">

      <!-- Theme Toggle -->
      <button id="theme-toggle" class="p-2.5 rounded-xl transition-all duration-300 hover:scale-110 hover-target"
              style={`color: var(--color-text-muted); background: transparent;`}
              aria-label="Toggle theme">
        <!-- Sun icon (visible in dark mode) -->
        <svg class="w-4 h-4 dark-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="w-4 h-4 light-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- GitHub -->
      <a href="https://github.com/gae-22/www-gae-jp" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
         class="p-2.5 rounded-xl transition-all duration-300 hover:scale-110 hover-target"
         style={`color: var(--color-text-muted);`}>
        <Icon name="lucide:github" class="w-4 h-4" />
      </a>
    </div>

  </div>
</header>

<style>
  /* Theme icon visibility */
  html.dark .dark-icon { display: block; }
  html.dark .light-icon { display: none; }
  html:not(.dark) .dark-icon { display: none; }
  html:not(.dark) .light-icon { display: block; }

  /* Active nav glow */
  .active-nav {
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  /* Magnetic link subtle shift on hover */
  .magnetic-link {
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s, background 0.2s;
  }
  .magnetic-link:not(.active-nav):hover {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
  }
</style>

<script>
  // Magnetic hover effect
  document.querySelectorAll('[data-magnetic]').forEach(el => {
    const htmlEl = el as HTMLElement;
    htmlEl.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = htmlEl.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      htmlEl.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
    });
    htmlEl.addEventListener('mouseleave', () => {
      htmlEl.style.transform = 'translate(0, 0)';
    });
  });
</script>
