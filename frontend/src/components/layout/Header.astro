---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<!-- Scroll progress indicator -->
<div class="scroll-progress" aria-hidden="true">
  <div id="scroll-progress-bar" class="scroll-progress-bar"></div>
</div>

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-700">
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="flex items-center group" aria-label="Home">
      <span class="font-heading font-bold text-sm tracking-tight text-text-primary group-hover:text-accent transition-colors duration-300">gae</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-10">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "font-mono text-[11px] uppercase tracking-[0.15em] transition-colors duration-300 relative",
                isActive
                  ? "text-accent"
                  : "text-text-secondary hover:text-text-primary"
              ]}
            >
              {item.label}
              {isActive && <span class="absolute -bottom-1 left-0 w-full h-px bg-accent"></span>}
            </a>
          </li>
        );
      })}
      <li class="ml-2">
        <a href="https://github.com/gae-22" target="_blank" rel="noopener noreferrer"
           class="text-text-secondary hover:text-text-primary transition-colors duration-300"
           aria-label="GitHub">
          <Icon name="lucide:github" class="w-4 h-4" />
        </a>
      </li>
    </ul>

    <!-- Mobile Menu Button -->
    <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2 group" aria-label="Toggle menu" aria-expanded="false">
      <span class="menu-line w-6 h-px bg-text-primary transition-all duration-300 origin-center"></span>
      <span class="menu-line w-6 h-px bg-text-primary transition-all duration-300"></span>
    </button>

  </nav>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-void flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-500">
  <nav class="flex flex-col items-center gap-10">
    <a href="/" class="font-display text-4xl font-bold text-text-primary hover:text-accent transition-colors duration-300 mobile-nav-link">
      Home
    </a>
    {navItems.map((item, i) => (
      <a
        href={item.href}
        class="font-display text-4xl font-bold text-text-primary hover:text-accent transition-colors duration-300 mobile-nav-link"
        style={`transition-delay: ${(i + 1) * 0.05}s`}
      >
        {item.label}
      </a>
    ))}
    <a href="https://github.com/gae-22" target="_blank" rel="noopener noreferrer"
       class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.15em] text-text-secondary hover:text-text-primary transition-colors duration-300 mt-6">
      <Icon name="lucide:github" class="w-5 h-5" />
      <span>GitHub</span>
    </a>
  </nav>
</div>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const progressBar = document.getElementById('scroll-progress-bar');
    if (!header || !menuToggle || !mobileMenu) return;

    let isOpen = false;

    // Scroll effect + progress bar
    const onScroll = () => {
      // Header background
      if (window.scrollY > 50) {
        header.style.backgroundColor = 'rgba(10, 10, 10, 0.85)';
        header.style.backdropFilter = 'blur(20px)';
        (header.style as any).WebkitBackdropFilter = 'blur(20px)';
      } else {
        header.style.backgroundColor = 'transparent';
        header.style.backdropFilter = 'none';
        (header.style as any).WebkitBackdropFilter = 'none';
      }

      // Scroll progress
      if (progressBar) {
        const scrollH = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollH > 0 ? window.scrollY / scrollH : 0;
        progressBar.style.transform = `scaleX(${progress})`;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Mobile menu toggle
    const lines = menuToggle.querySelectorAll<HTMLElement>('.menu-line');
    menuToggle.addEventListener('click', () => {
      isOpen = !isOpen;
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
        lines[0].style.transform = 'rotate(45deg) translateY(4px)';
        lines[1].style.transform = 'rotate(-45deg) translateY(-4px)';
      } else {
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
        lines[0].style.transform = '';
        lines[1].style.transform = '';
      }
    });

    // Close on link click
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        isOpen = false;
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
        lines[0].style.transform = '';
        lines[1].style.transform = '';
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:after-swap', initHeader);
</script>
