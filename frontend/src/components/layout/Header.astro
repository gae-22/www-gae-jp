---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Work', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-8 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <nav class="pointer-events-auto flex items-center gap-1 p-1.5 pr-2 rounded-full glass-card border border-white/40 shadow-xl shadow-indigo-500/5 transition-all duration-500 hover:shadow-indigo-500/10 hover:scale-[1.01]">

    <!-- Logo -->
    <a href="/" class="pl-3 pr-4 py-2 flex items-center gap-2 group" aria-label="Home">
        <div class="relative flex items-center justify-center w-8 h-8 bg-zinc-900 text-white rounded-full overflow-hidden shadow-inner transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110">
             <span class="font-heading font-bold text-sm tracking-tighter">g</span>
        </div>
        <span class="font-heading font-bold text-sm tracking-tight text-zinc-800 hidden sm:block group-hover:text-indigo-600 transition-colors">gae</span>
    </a>

    <!-- Divider -->
    <div class="w-px h-6 bg-zinc-200 mx-1"></div>

    <!-- Nav Items -->
    <ul class="flex items-center gap-1 relative">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 rounded-full text-xs font-semibold transition-all duration-300 tracking-wide flex items-center justify-center overflow-hidden group",
                isActive
                    ? "text-white bg-zinc-900 shadow-md shadow-zinc-900/20"
                    : "text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100"
              ]}
            >
              <span class="relative z-10">{item.label}</span>
              {isActive && (
                  <span class="absolute inset-0 bg-linear-to-tr from-zinc-800 to-zinc-900"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Divider -->
    <div class="w-px h-6 bg-zinc-200 mx-1"></div>

    <!-- Social -->
    <a href="https://github.com/gae-22/www-gae-jp" target="_blank" rel="noopener noreferrer"
       class="p-2 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all duration-300 hover:scale-110 hover:rotate-12"
       aria-label="GitHub">
      <Icon name="lucide:github" class="w-4 h-4" />
    </a>

  </nav>
</header>
