---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Home', href: '/', icon: 'lucide:home' },
  { label: 'Blog', href: '/blog', icon: 'lucide:pen-tool' },
  { label: 'Projects', href: '/projects', icon: 'lucide:folder' },
  { label: 'About', href: '/about', icon: 'lucide:user' },
];

const socialItems = [
  { label: 'GitHub', href: 'https://github.com/gae-22/www-gae-jp', icon: 'lucide:github' },
  { label: 'Discord', href: 'https://discord.gg/nqsegJHjBb', icon: 'simple-icons:discord' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 pt-5 px-4" id="site-header">
  <nav class="max-w-xl mx-auto rounded-2xl px-2 py-2 flex items-center justify-between transition-all duration-500 whitespace-nowrap border border-transparent" id="site-nav">

    <!-- Internal Links -->
    <ul class="flex items-center gap-0.5 md:gap-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
        <li>
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-2 px-3.5 py-2 rounded-xl transition-all duration-300 group relative",
              isActive
                ? "bg-accent-indigo/8 text-accent-indigo"
                : "hover:bg-stone-100/80 text-ink-muted hover:text-ink"
            ]}
          >
            <Icon name={item.icon} class:list={[
              "w-4 h-4 transition-colors duration-300",
              isActive ? "text-accent-indigo" : "group-hover:text-ink"
            ]} />
            <span class:list={[
              "text-xs font-medium transition-colors duration-300 hidden md:block",
              isActive ? "text-accent-indigo font-semibold" : "group-hover:text-ink"
            ]}>{item.label}</span>
            {isActive && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-accent-indigo"></span>
            )}
          </a>
        </li>
      )})}
    </ul>

    <div class="w-px h-5 bg-stone-200/60 mx-1 hidden md:block"></div>

    <!-- Social Links -->
    <ul class="flex items-center gap-1">
      {socialItems.map((item) => (
        <li>
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={item.label}
            class="p-2.5 rounded-xl hover:bg-stone-100/80 text-ink-muted hover:text-ink transition-all duration-300 block"
          >
            <Icon name={item.icon} class="w-4 h-4" />
          </a>
        </li>
      ))}
    </ul>

  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const nav = document.getElementById('site-nav');
  let lastScroll = 0;
  let ticking = false;

  function updateHeader() {
    const scrollY = window.scrollY;
    if (nav) {
      if (scrollY > 40) {
        nav.classList.add('bg-white/85', 'backdrop-blur-2xl', 'shadow-[0_2px_20px_-4px_rgba(0,0,0,0.06)]', 'border-stone-200/50');
        nav.classList.remove('border-transparent');
      } else {
        nav.classList.remove('bg-white/85', 'backdrop-blur-2xl', 'shadow-[0_2px_20px_-4px_rgba(0,0,0,0.06)]', 'border-stone-200/50');
        nav.classList.add('border-transparent');
      }
    }
    lastScroll = scrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  updateHeader();
</script>
