---
import { Icon } from 'astro-icon/components';

const navItems = [
  { label: 'Work', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-6 left-0 right-0 z-50 flex justify-center pointer-events-none">
  <nav class="pointer-events-auto flex items-center gap-2 p-2 rounded-full glass-card border border-white/50 shadow-xl shadow-indigo-500/5 transition-all duration-500 hover:shadow-indigo-500/15 hover:scale-[1.005]">

    <!-- Logo -->
    <a href="/" class="pl-2 pr-4 py-1 flex items-center gap-2.5 group" aria-label="Home">
        <div class="relative flex items-center justify-center w-10 h-10 text-white rounded-full overflow-hidden shadow-inner transition-transform duration-500 group-hover:rotate-360 group-hover:scale-110">
             <img src="/gae.svg" alt="gae logo" class="w-full h-full object-cover scale-80" />
        </div>
        <span class="font-heading font-bold text-sm tracking-tight text-zinc-800 hidden sm:block group-hover:text-indigo-600 transition-colors">gae</span>
    </a>

    <!-- Divider -->
    <div class="w-px h-5 bg-zinc-200/80 mx-1"></div>

    <!-- Nav Items -->
    <ul class="flex items-center gap-1.5 relative">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 rounded-full text-xs font-medium transition-all duration-500 tracking-wide flex items-center justify-center overflow-hidden group",
                isActive
                    ? "text-zinc-900 font-bold bg-white shadow-sm ring-1 ring-zinc-200"
                    : "text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100/80"
              ]}
            >
              <span class="relative z-10">{item.label}</span>
              {isActive && (
                  <span class="absolute inset-0 bg-linear-to-tr from-white to-zinc-50 opacity-100"></span>
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Divider -->
    <div class="w-px h-5 bg-zinc-200/80 mx-1"></div>

    <!-- Social -->
    <a href="https://github.com/gae-22/www-gae-jp" target="_blank" rel="noopener noreferrer"
       class="p-2.5 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-900 transition-all duration-300 hover:scale-110 hover:rotate-12 group"
       aria-label="GitHub">
      <Icon name="lucide:github" class="w-4 h-4 transition-transform duration-300 group-hover:scale-110" />
    </a>

  </nav>
</header>
