---
import Layout from './Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
    headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, publishedAt, cover, coverAlt } = post.data;
---

<Layout title={`${title} | gae`} description={description} image={cover?.src}>
    <!-- Reading Progress Bar -->
    <div class="fixed top-0 left-0 w-full h-0.5 z-60" style={`background: var(--color-border-subtle);`}>
        <div class="h-full origin-left scale-x-0 transition-transform duration-100 ease-out" id="reading-progress"
             style="background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));"></div>
    </div>

    <Header />

    <article class="min-h-screen">
        <!-- Immersive Header -->
        <div class="relative h-[60vh] md:h-[75vh] w-full flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 z-0">
                {cover ? (
                    <Image src={cover} alt={coverAlt || ""} class="w-full h-full object-cover blur-3xl opacity-30 scale-110" />
                ) : (
                    <div class="w-full h-full" style="background: linear-gradient(135deg, var(--color-dark-bg), var(--color-dark-surface-2));"></div>
                )}
                <div class="absolute inset-0" style="background: rgba(10,10,11,0.6);"></div>
                <div class="absolute inset-0 opacity-[0.02] pointer-events-none mix-blend-overlay bg-[url('/noise.webp')]"></div>
            </div>

            <div class="relative z-10 text-center px-6 max-w-5xl mx-auto space-y-8 reveal">
                <div class="flex items-center justify-center gap-4 text-xs font-mono uppercase tracking-[0.25em]" style="color: rgba(255,255,255,0.4);">
                    <span class="w-8 h-px" style="background: rgba(255,255,255,0.2);"></span>
                    <time datetime={publishedAt.toISOString()}>
                        {publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    <span class="w-8 h-px" style="background: rgba(255,255,255,0.2);"></span>
                </div>

                <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold leading-[1.08] text-white tracking-tight drop-shadow-md text-balance">
                    {title}
                </h1>

                {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap justify-center gap-3">
                        {post.data.tags.map(tag => (
                            <span class="px-4 py-1.5 rounded-xl text-[10px] font-mono font-bold uppercase tracking-wider transition-colors duration-300"
                                  style="border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); backdrop-filter: blur(8px);">
                                {tag}
                            </span>
                        ))}
                    </div>
                )}
            </div>

            <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-20">
                <div class="w-px h-12" style="background: linear-gradient(to bottom, white, transparent);"></div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="relative z-20" style={`background: var(--color-bg); border-top: 1px solid var(--color-border-subtle);`}>
            <div class="max-w-7xl mx-auto px-6 py-16 lg:py-24 grid grid-cols-1 lg:grid-cols-12 gap-16">

                <!-- TOC Sidebar -->
                <aside class="hidden lg:block lg:col-span-3">
                    <div class="sticky top-32 space-y-8">
                        <div class="p-7 rounded-2xl"
                             style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                            <h4 class="text-[10px] font-mono uppercase tracking-[0.25em] mb-6 opacity-40" style={`color: var(--color-text-muted);`}>Contents</h4>
                            <ul class="space-y-3.5 text-sm font-light" style={`color: var(--color-text-muted);`}>
                                {headings.filter(h => h.depth <= 3).map((heading) => (
                                    <li class="transition-colors duration-300 hover-target">
                                        <a href={`#${heading.slug}`} class:list={[
                                            "block transition-colors duration-300 hover:text-accent",
                                            heading.depth === 3 ? "pl-4 text-xs" : ""
                                        ]}>
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                                {headings.length === 0 && (
                                    <li class="italic opacity-40 text-xs">No headings</li>
                                )}
                            </ul>
                        </div>
                    </div>
                </aside>

                <!-- Prose -->
                <div class="col-span-1 lg:col-span-7 lg:col-start-5 prose prose-lg max-w-none
                    prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight
                    prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-8 prose-h2:pb-4 prose-h2:scroll-mt-44
                    prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-6 prose-h3:scroll-mt-44
                    prose-p:leading-relaxed prose-p:font-light prose-p:mb-8 prose-p:text-balance
                    prose-a:no-underline prose-a:border-b prose-a:transition-colors
                    prose-strong:font-bold
                    prose-blockquote:border-l-accent-2 prose-blockquote:py-4 prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:italic
                    prose-ul:list-disc prose-ul:pl-8 prose-li:mb-3
                    prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
                    prose-pre:bg-transparent! prose-pre:m-0! prose-pre:p-0! prose-pre:shadow-none! prose-pre:rounded-none!
                    prose-img:rounded-2xl prose-img:shadow-xl"
                     style={`
                        --tw-prose-body: var(--color-text-muted);
                        --tw-prose-headings: var(--color-text);
                        --tw-prose-links: var(--color-accent);
                        --tw-prose-bold: var(--color-text);
                        --tw-prose-quotes: var(--color-text-muted);
                        --tw-prose-quote-borders: var(--color-accent-2);
                        --tw-prose-code: var(--color-accent);
                        --tw-prose-hr: var(--color-border);
                        color: var(--color-text-muted);
                     `}>
                    <style>
                        .prose h2 { border-bottom: 1px solid var(--color-border); }
                        .prose code:not(pre code) {
                            background: color-mix(in srgb, var(--color-accent) 8%, transparent);
                            border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
                        }
                        .prose blockquote {
                            background: color-mix(in srgb, var(--color-surface-2) 50%, transparent);
                        }
                        .prose img {
                            border: 1px solid var(--color-border);
                        }
                        .prose a {
                            border-bottom-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
                        }
                        .prose a:hover {
                            border-bottom-color: var(--color-accent);
                        }
                    </style>
                    <slot />
                </div>

            </div>
        </div>
    </article>

    <Footer />

    <script>
        const progressBar = document.getElementById('reading-progress');
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const scrollPercent = scrollTop / docHeight;
            if (progressBar) {
                progressBar.style.transform = `scaleX(${scrollPercent})`;
            }
        });
    </script>
</Layout>
