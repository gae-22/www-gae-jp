---
import Layout from './Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
	post: CollectionEntry<'blog'>;
    headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, publishedAt, cover, coverAlt } = post.data;
---

<Layout title={`${title} | gae`} description={description} image={cover?.src}>

    <Header />

    <article class="min-h-screen">

        <!-- Header -->
        <header class="pt-40 pb-20 px-6 max-w-4xl mx-auto text-center">

            <div class="flex items-center justify-center gap-4 text-[10px] font-mono uppercase tracking-[0.2em] text-text-tertiary mb-8">
                <time datetime={publishedAt.toISOString()}>
                    {publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <span>·</span>
                <span>{post.data.tags[0] || 'Article'}</span>
            </div>

            <h1 class="text-4xl md:text-6xl font-display font-bold leading-tight text-text-primary mb-8 text-balance">
                {title}
            </h1>

            {cover && (
                <div class="w-full aspect-video rounded-2xl overflow-hidden mt-12 relative border border-border-subtle">
                    <Image src={cover} alt={coverAlt || ""} class="w-full h-full object-cover" />
                </div>
            )}

        </header>

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">

            <!-- Sidebar (TOC) -->
            <aside class="hidden lg:block lg:col-span-3 lg:col-start-1">
                <div class="sticky top-32">
                    <h4 class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-tertiary mb-6">Contents</h4>
                    <ul class="space-y-3 text-sm border-l border-border-subtle pl-4">
                        {headings.filter(h => h.depth <= 3).map((heading) => (
                            <li class="transition-colors duration-300">
                                <a href={`#${heading.slug}`} class:list={[
                                    "block text-text-secondary hover:text-accent transition-colors duration-300",
                                    heading.depth === 3 ? "pl-4 text-xs" : ""
                                ]}>
                                    {heading.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </aside>

            <!-- Prose -->
            <div class="lg:col-span-7 lg:col-start-4 pb-32">
                <div class="prose prose-lg prose-invert max-w-none
                    prose-headings:font-display prose-headings:font-bold prose-headings:text-text-primary
                    prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6
                    prose-p:leading-8 prose-p:text-text-secondary
                    prose-a:text-accent prose-a:no-underline prose-a:font-medium hover:prose-a:underline
                    prose-img:rounded-2xl
                    prose-code:text-accent prose-code:bg-accent-dim prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                    prose-pre:bg-void-elevated prose-pre:text-text-primary prose-pre:rounded-2xl prose-pre:border prose-pre:border-border-subtle">
                    <slot />
                </div>

                <div class="mt-20 pt-10 border-t border-border-subtle">
                     <a href="/blog" class="link-hover inline-flex items-center gap-2 text-sm font-mono text-accent transition-colors">
                        <Icon name="lucide:arrow-left" class="w-4 h-4" />
                        Back to Blog
                     </a>
                </div>
            </div>

        </div>

    </article>

    <Footer />
</Layout>
