---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { getEntry } from 'astro:content';

const projectsEntry = await getEntry('projects', 'projects');
const projects = projectsEntry?.data ?? [];
---

<Layout title="Projects | gae" description="Projects and Works.">
  <Header />

  <main class="min-h-screen pt-32 pb-32 px-6 relative overflow-hidden">

    {/* Floating accent dots */}
    <div class="floating-dot" style="top: 15%; right: 10%; animation-delay: -2s; animation-duration: 16s;"></div>
    <div class="floating-dot" style="top: 55%; left: 4%; animation-delay: -6s; animation-duration: 14s; opacity: 0.2;"></div>
    <div class="floating-dot" style="top: 80%; right: 15%; animation-delay: -10s; animation-duration: 20s; opacity: 0.15;"></div>

    <div class="max-w-5xl mx-auto relative z-10">

      <!-- Page header -->
      <header class="mb-20 reveal-item" data-scroll-skew>
        <div class="page-section-label reveal-item">
          <span>Projects</span>
          <div class="section-line-animated"></div>
        </div>
        <h1 class="page-title text-5xl md:text-7xl" data-scramble>
          Selected Work
        </h1>
        <p class="text-text-secondary text-sm font-mono mt-4 tracking-wide uppercase reveal-item reveal-delay-2">
          {projects.length} projects & counting
        </p>
      </header>

      <section class="flex flex-col gap-6">
        {projects.map((project, index) => {
          const thumbSrc = (project.thumb as any)?.src ?? project.thumb;
          return (
            <a href={project.url} target="_blank" rel="noopener noreferrer"
               class="project-card block p-8 md:p-12 group reveal-item"
               style={`transition-delay: ${index * 0.12}s`}
               data-cursor-text="View"
               data-magnetic>

              <div class="relative z-10 flex flex-col md:flex-row md:items-start md:justify-between gap-6">

                {/* Left: Number + Info */}
                <div class="flex-1">
                  <div class="flex items-baseline gap-6 mb-6">
                    <span class="project-number font-mono text-5xl md:text-6xl font-bold text-text-tertiary transition-colors duration-600">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div class="hidden md:block flex-1 h-px bg-border-subtle group-hover:bg-border-hover transition-colors duration-500"></div>
                  </div>
                  <h2 class="font-heading text-2xl md:text-3xl font-bold text-text-primary mb-3 group-hover:text-accent transition-colors duration-300" data-scramble>
                    {project.title}
                  </h2>
                  <p class="font-body text-sm text-text-secondary max-w-md leading-relaxed">
                    {project.description}
                  </p>
                </div>

                {/* Right: Tech tags + Arrow */}
                <div class="flex flex-col items-end gap-6">
                  {project.tech && project.tech.length > 0 && (
                    <div class="flex flex-wrap gap-2 md:pt-16 md:justify-end">
                      {project.tech.map((t: string) => (
                        <span class="px-3 py-1 rounded-full border border-border-hover font-mono text-[10px] uppercase tracking-wider text-text-secondary group-hover:border-accent/20 group-hover:text-text-primary transition-all duration-300">
                          {t}
                        </span>
                      ))}
                    </div>
                  )}

                  {/* Arrow */}
                  <div class="flex items-center gap-3 opacity-0 -translate-x-2.5 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-500">
                    <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-accent">View</span>
                    <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
                    </svg>
                  </div>
                </div>

              </div>
            </a>
          );
        })}
      </section>

    </div>
  </main>

  <Footer />
</Layout>
