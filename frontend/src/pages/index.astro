---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import PageLoader from '~/components/features/home/PageLoader.astro';
import AmbientBackground from '~/components/features/home/AmbientBackground.astro';
import Hero from '~/components/features/home/Hero.astro';
import MarqueeStrip from '~/components/features/home/MarqueeStrip.astro';
import AboutStatement from '~/components/features/home/AboutStatement.astro';
import BentoGrid from '~/components/features/home/BentoGrid.astro';
import ProjectShowcase from '~/components/features/home/ProjectShowcase.astro';
import LatestPost from '~/components/features/home/LatestPost.astro';
import ContactCTA from '~/components/features/home/ContactCTA.astro';
---

<Layout title="gae — Software Engineer">
  <PageLoader />
  <AmbientBackground />
  <Header />

  <main class="relative">
    <Hero />
    <MarqueeStrip />
    <AboutStatement />
    <BentoGrid />
    <!-- <ProjectShowcase /> -->
    <LatestPost />
    <ContactCTA />
  </main>

  <Footer />
</Layout>
