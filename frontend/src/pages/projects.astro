---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

// Projects are managed via src/content/projects/projects.yaml
const projectsEntry = await getEntry('projects', 'projects');
const projects = projectsEntry?.data ?? [];
---

<Layout title="Projects | gae" description="Projects and Works.">
  <Header />

  <main class="min-h-screen relative overflow-hidden">
    <!-- Background accents -->
    <div class="absolute top-0 right-0 -z-10 w-2/3 h-screen bg-[radial-gradient(circle_at_top_right,var(--color-accent-indigo),transparent)] opacity-[0.04] blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -z-10 w-2/3 h-[50vh] bg-[radial-gradient(circle_at_bottom_left,var(--color-accent-teal),transparent)] opacity-[0.04] blur-[120px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 pt-36 pb-20">
      <!-- Page header -->
      <header class="mb-14 reveal">
        <span class="text-[11px] font-mono font-medium text-accent-teal tracking-widest uppercase">Projects</span>
        <h1 class="text-4xl md:text-5xl font-display font-bold leading-tight mt-3 text-ink tracking-tight">
          My Work — <span class="text-transparent bg-clip-text bg-linear-to-r from-accent-indigo to-accent-teal">Selected Projects</span>
        </h1>
        <div class="mt-4 w-16 h-1 bg-linear-to-r from-accent-indigo to-accent-teal rounded-full"></div>
      </header>

      <section class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {projects.map((project, index) => {
          const thumbSrc = (project.thumb as any)?.src ?? project.thumb;
          return (
            <article class={`glass-card p-6 rounded-3xl flex gap-5 items-start group hover:shadow-xl transition-all duration-400 reveal`} style={`transition-delay: ${index * 0.08}s;`}>
              <a class="w-24 h-24 shrink-0 rounded-2xl overflow-hidden bg-linear-to-br from-stone-50 to-stone-100 flex items-center justify-center border border-stone-200/60 group-hover:scale-[1.05] transition-transform duration-300" href={project.url} target="_blank" rel="noopener noreferrer">
                <img src={thumbSrc as string | undefined} alt={project.title} class="w-full h-full object-cover" />
              </a>

              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3">
                  <a class="text-lg font-bold hover:text-accent-indigo text-ink transition-colors duration-300 font-display" href={project.url} target="_blank" rel="noopener noreferrer">{project.title}</a>
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="p-1.5 rounded-lg text-stone-400 hover:text-accent-indigo hover:bg-indigo-50/50 transition-all duration-300 shrink-0 opacity-0 group-hover:opacity-100 translate-x-1 group-hover:translate-x-0">
                    <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
                  </a>
                </div>

                <p class="text-sm text-ink-muted mt-1.5 leading-relaxed line-clamp-2">{project.description}</p>

                <div class="flex flex-wrap gap-1.5 mt-3">
                  {project.tech.map(t => (
                    <span class="px-2.5 py-1 rounded-lg bg-stone-50 border border-stone-200/60 text-[11px] font-medium text-stone-600">{t}</span>
                  ))}
                </div>
              </div>
            </article>
          );
        })}
      </section>
    </div>
  </main>

  <Footer />
</Layout>
