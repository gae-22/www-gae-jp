---
export const prerender = false;
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Timeline from '~/components/features/about/Timeline.astro';
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';


const aboutEntry = await getEntry('about', 'profile');
if (!aboutEntry) {
    throw new Error('About profile not found');
}

const profile = aboutEntry.data;

// Icon resolver
const getDefaultIcon = (name: string | undefined | null) => {
  if (!name) return null;
  const n = name.toLowerCase();
  if (n.includes('typescript')) return 'logos:typescript-icon';
  if (n.includes('javascript')) return 'logos:javascript';
  if (n.includes('python')) return 'logos:python';
  if (n === 'go' || n === 'golang') return 'logos:go';
  if (n.includes('rust')) return 'logos:rust';
  if (n.includes('java')) return 'logos:java';
  if (n.includes('c++')) return 'logos:c-plusplus';
  if (n === 'c') return 'logos:c';
  if (n.includes('react')) return 'logos:react';
  if (n.includes('next')) return 'logos:nextjs-icon';
  if (n.includes('astro')) return 'logos:astro-icon';
  if (n.includes('tailwind')) return 'logos:tailwindcss-icon';
  if (n.includes('node')) return 'logos:nodejs-icon';
  if (n.includes('hono')) return 'logos:hono';
  if (n.includes('vue')) return 'logos:vue';
  if (n.includes('fastapi')) return 'logos:fastapi-icon';
  if (n.includes('flask')) return 'logos:flask';
  if (n.includes('django')) return 'logos:django-icon';
  if (n.includes('docker')) return 'logos:docker-icon';
  if (n.includes('aws')) return 'logos:aws';
  if (n.includes('gcp') || n.includes('google cloud')) return 'logos:google-cloud';
  if (n.includes('firebase')) return 'logos:firebase';
  if (n.includes('cloudflare')) return 'logos:cloudflare-icon';
  if (n.includes('linux')) return 'logos:linux-tux';
  if (n.includes('git')) return 'logos:git-icon';
  if (n.includes('vscode') || n.includes('vs code')) return 'logos:visual-studio-code';
  if (n.includes('mac') || n.includes('apple')) return 'logos:apple';
  if (n.includes('hhkb') || n.includes('keyboard')) return 'lucide:keyboard';
  if (n.includes('ergo') || n.includes('mouse') || n.includes('trackball')) return 'lucide:mouse';
  if (n.includes('antigravity')) return 'lucide:code';
  return null;
};

const skillCategories = [
  { label: 'Languages', items: profile.skills.languages, accent: '--color-accent' },
  { label: 'Frameworks', items: profile.skills.frameworks, accent: '--color-accent-2' },
  { label: 'Others', items: profile.skills.others, accent: '--color-accent' },
];
---

<Layout title="About | gae" description="About gae.">
  <Header />

  <main class="min-h-screen">

      <!-- Cinematic Header -->
      <section class="min-h-[60svh] flex items-end pb-16 px-6 relative overflow-hidden">
          <div class="max-w-5xl mx-auto w-full">
              <div class="space-y-8 reveal">
                  <span class="text-[11px] font-mono font-medium uppercase tracking-[0.3em] block" style={`color: var(--color-accent);`}>Profile</span>
                  <h1 class="font-display font-extrabold leading-[0.95] tracking-[-0.03em]" style={`font-size: clamp(3rem, 8vw, 7rem); color: var(--color-text);`}>
                      Hello, I'm<br />
                      <span class="text-gradient">{profile.name}</span>.
                  </h1>
                  <div class="flex flex-wrap gap-2 stagger-children reveal">
                      {profile.roles.map((role: string) => (
                          <div class="px-4 py-2 rounded-xl text-xs font-medium transition-all duration-300 hover:scale-[1.05] hover-target"
                               style={`border: 1px solid var(--color-border); color: var(--color-text-muted); background: color-mix(in srgb, var(--color-surface) 60%, transparent); backdrop-filter: blur(8px);`}>
                            {role}
                          </div>
                      ))}
                  </div>
              </div>
          </div>
      </section>

      <!-- Stats -->
      <section class="max-w-5xl mx-auto px-6 mb-24">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 stagger-children reveal">
              <div class="p-6 rounded-2xl transition-all duration-300 hover:scale-[1.03] hover-target group"
                   style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <span class="text-4xl font-display font-bold block mb-1 transition-colors duration-300" style={`color: var(--color-text);`}>{profile.stats.experience}</span>
                  <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style={`color: var(--color-text-muted);`}>Years Exp</span>
              </div>
              <div class="p-6 rounded-2xl transition-all duration-300 hover:scale-[1.03] hover-target group"
                   style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <span class="text-4xl font-display font-bold block mb-1 transition-colors duration-300" style={`color: var(--color-text);`}>{profile.stats.projects}</span>
                  <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style={`color: var(--color-text-muted);`}>Projects</span>
              </div>
              <div class="p-6 rounded-2xl transition-all duration-300 hover:scale-[1.03] hover-target group"
                   style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <span class="text-4xl font-display font-bold block mb-1 transition-colors duration-300" style={`color: var(--color-text);`}>∞</span>
                  <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style={`color: var(--color-text-muted);`}>Curiosity</span>
              </div>
              <div class="p-6 rounded-2xl transition-all duration-300 hover:scale-[1.03] hover-target group"
                   style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <span class="text-4xl font-display font-bold block mb-1" style={`color: var(--color-accent);`}>☕</span>
                  <span class="text-[10px] font-mono uppercase tracking-[0.2em]" style={`color: var(--color-text-muted);`}>Fuel</span>
              </div>
          </div>
      </section>

      <div class="max-w-5xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 pb-20">

          <!-- Main Content: Timeline -->
          <div class="lg:col-span-7 space-y-12">
              <section class="reveal">
                  <div class="flex items-center gap-3 mb-8">
                      <div class="p-2.5 rounded-xl" style={`background: color-mix(in srgb, var(--color-accent) 10%, transparent); color: var(--color-accent);`}>
                          <Icon name="lucide:briefcase" class="w-5 h-5" />
                      </div>
                      <h2 class="text-2xl font-display font-bold" style={`color: var(--color-text);`}>Career</h2>
                  </div>
                  <Timeline events={profile.timeline} />
              </section>
          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-5 space-y-6">

              <!-- Tech & Gear -->
              <section class="p-7 rounded-2xl overflow-hidden relative group reveal"
                       style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <div class="absolute top-0 right-0 w-40 h-40 rounded-full blur-[80px] opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                       style={`background: var(--color-accent-2);`}></div>
                  <div class="relative z-10">
                      <div class="flex items-center gap-3 mb-6">
                          <div class="p-2 rounded-xl" style={`background: color-mix(in srgb, var(--color-accent-2) 10%, transparent); color: var(--color-accent-2);`}>
                              <Icon name="lucide:cpu" class="w-5 h-5" />
                          </div>
                          <h2 class="text-xl font-display font-bold" style={`color: var(--color-text);`}>Tech & Gear</h2>
                      </div>
                      <div class="flex flex-wrap gap-2 stagger-children reveal">
                          {profile.gear.map((item: string) => {
                              const icon = getDefaultIcon(item);
                              return (
                                  <div class="group/item px-3.5 py-2 rounded-xl flex items-center gap-2 transition-all duration-300 hover:scale-[1.04] hover:-translate-y-0.5 hover-target"
                                       style={`border: 1px solid var(--color-border-subtle); background: color-mix(in srgb, var(--color-surface-2) 50%, transparent);`}>
                                      {icon ? <Icon name={icon} class="w-4 h-4" /> : <span class="w-1.5 h-1.5 rounded-full" style={`background: var(--color-accent-2);`}></span>}
                                      <span class="text-sm font-medium" style={`color: var(--color-text-muted);`}>{item}</span>
                                  </div>
                              );
                          })}
                      </div>
                  </div>
              </section>

              <!-- Skills -->
              <section class="p-7 rounded-2xl overflow-hidden relative group reveal reveal-delay-1"
                       style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <div class="absolute top-0 right-0 w-44 h-44 rounded-full blur-[80px] opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                       style={`background: var(--color-accent);`}></div>
                  <div class="relative z-10">
                      <div class="flex items-center gap-3 mb-6">
                          <div class="p-2 rounded-xl" style={`background: color-mix(in srgb, var(--color-accent) 10%, transparent); color: var(--color-accent);`}>
                              <Icon name="lucide:layers" class="w-5 h-5" />
                          </div>
                          <h2 class="text-xl font-display font-bold" style={`color: var(--color-text);`}>Skills</h2>
                      </div>
                      <div class="space-y-6">
                          {skillCategories.map(({ label, items }) => (
                              <div>
                                  <h3 class="text-[10px] font-mono uppercase tracking-[0.2em] mb-3" style={`color: var(--color-text-muted); opacity: 0.5;`}>{label}</h3>
                                  <div class="flex flex-wrap gap-2 stagger-children reveal">
                                      {items.map((item: string) => {
                                          const icon = getDefaultIcon(item);
                                          return (
                                              <div class="group/item px-3.5 py-2 rounded-xl flex items-center gap-2 transition-all duration-300 hover:scale-[1.04] hover:-translate-y-0.5 hover-target"
                                                   style={`border: 1px solid var(--color-border-subtle); background: color-mix(in srgb, var(--color-surface-2) 50%, transparent);`}>
                                                  {icon ? <Icon name={icon} class="w-4 h-4" /> : <span class="w-1.5 h-1.5 rounded-full" style={`background: var(--color-accent);`}></span>}
                                                  <span class="text-sm font-medium" style={`color: var(--color-text-muted);`}>{item}</span>
                                              </div>
                                          );
                                      })}
                                  </div>
                              </div>
                          ))}
                      </div>
                  </div>
              </section>

              <!-- Policy -->
              <section class="p-7 rounded-2xl overflow-hidden relative group reveal reveal-delay-2"
                       style={`background: var(--color-surface); border: 1px solid var(--color-border-subtle);`}>
                  <div class="absolute top-0 right-0 w-28 h-28 rounded-full blur-[60px] opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                       style={`background: var(--color-accent);`}></div>
                  <div class="relative z-10">
                      <Icon name="lucide:sparkles" class="w-7 h-7 mb-4" style={`color: var(--color-accent);`} />
                      <h3 class="text-lg font-bold font-display mb-2" style={`color: var(--color-text);`}>Policy</h3>
                      <p class="text-sm leading-relaxed text-balance" style={`color: var(--color-text-muted);`}>
                          技術は課題解決の手段．<br>
                          常にユーザーの視点に立ち，シンプルかつ堅牢な実装で，長く愛されるシステムを作ります．
                      </p>
                  </div>
              </section>
          </div>

      </div>
  </main>

  <Footer />
</Layout>
