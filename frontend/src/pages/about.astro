---
export const prerender = false;
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Timeline from '~/components/features/about/Timeline.astro';
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';


const aboutEntry = await getEntry('about', 'profile');
if (!aboutEntry) {
    throw new Error('About profile not found');
}

const profile = aboutEntry.data;

// Icon resolver (Simplified for brevity, ensuring covers main ones)
const getDefaultIcon = (name: string | undefined | null) => {
  if (!name) return null;
  const n = name.toLowerCase();
  const map: Record<string, string> = {
      typescript: 'logos:typescript-icon',
      javascript: 'logos:javascript',
      python: 'logos:python',
      go: 'logos:go',
      rust: 'logos:rust',
      react: 'logos:react',
      next: 'logos:nextjs-icon',
      astro: 'logos:astro-icon',
      tailwind: 'logos:tailwindcss-icon',
      docker: 'logos:docker-icon',
      linux: 'logos:linux-tux',
      git: 'logos:git-icon',
      vscode: 'logos:visual-studio-code',
  };

  for (const key of Object.keys(map)) {
      if (n.includes(key)) return map[key];
  }

  if (n.includes('aws')) return 'logos:aws';
  if (n.includes('gcp')) return 'logos:google-cloud';

  return 'lucide:code'; // Default
};

const skillCategories = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks', items: profile.skills.frameworks },
  { label: 'Others', items: profile.skills.others },
];
---

<Layout title="About | gae" description="About gae.">
  <Header />

  <main class="min-h-screen pt-32 pb-20 px-6">

      <!-- Cinematic Header -->
      <section class="max-w-5xl mx-auto mb-20 relative">
          <div class="space-y-6 reveal-item">
              <span class="text-accent-violet text-[10px] font-mono font-medium uppercase tracking-[0.3em] block">Profile</span>
              <h1 class="font-display font-extrabold text-6xl md:text-8xl tracking-tighter text-text-primary leading-[0.9]">
                  Hello, I'm<br />
                  <span class="text-gradient">{profile.name}</span>.
              </h1>
              <div class="flex flex-wrap gap-2">
                  {profile.roles.map((role: string) => (
                      <div class="px-4 py-2 rounded-full border border-zinc-200 bg-white/50 backdrop-blur-sm text-xs font-medium text-zinc-600 shadow-sm hover:scale-105 transition-transform cursor-default">
                        {role}
                      </div>
                  ))}
              </div>
          </div>
      </section>

      <!-- Stats -->
      <section class="max-w-5xl mx-auto mb-24">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="glass-card p-6 flex flex-col justify-center items-center text-center group">
                  <span class="text-4xl font-display font-bold text-text-primary mb-1 group-hover:scale-110 transition-transform">{profile.stats.experience}</span>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Years Exp</span>
              </div>
              <div class="glass-card p-6 flex flex-col justify-center items-center text-center group">
                  <span class="text-4xl font-display font-bold text-text-primary mb-1 group-hover:scale-110 transition-transform">{profile.stats.projects}</span>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Projects</span>
              </div>
              <div class="glass-card p-6 flex flex-col justify-center items-center text-center group">
                  <span class="text-4xl font-display font-bold text-text-primary mb-1 group-hover:scale-110 transition-transform">∞</span>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Curiosity</span>
              </div>
              <div class="glass-card p-6 flex flex-col justify-center items-center text-center group">
                  <span class="text-4xl font-display font-bold text-accent-orange mb-1 group-hover:rotate-12 transition-transform">☕</span>
                  <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-400">Fuel</span>
              </div>
          </div>
      </section>

      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-16">

          <!-- Main Content: Timeline -->
          <div class="lg:col-span-7 space-y-12">
              <section class="reveal-item">
                  <div class="flex items-center gap-3 mb-8">
                      <div class="p-2.5 rounded-xl bg-accent-blue/10 text-accent-blue">
                          <Icon name="lucide:briefcase" class="w-5 h-5" />
                      </div>
                      <h2 class="text-2xl font-display font-bold text-text-primary">Career</h2>
                  </div>
                  <Timeline events={profile.timeline} />
              </section>
          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-5 space-y-6">

              <!-- Tech & Gear -->
              <section class="glass-card p-8 group overflow-hidden relative">
                  <div class="absolute -top-10 -right-10 w-40 h-40 bg-accent-cyan/10 rounded-full blur-3xl group-hover:bg-accent-cyan/20 transition-colors"></div>

                  <div class="relative z-10">
                      <div class="flex items-center gap-3 mb-6">
                          <div class="p-2 rounded-xl bg-accent-cyan/10 text-accent-cyan">
                              <Icon name="lucide:cpu" class="w-5 h-5" />
                          </div>
                          <h2 class="text-xl font-display font-bold text-text-primary">Tech & Gear</h2>
                      </div>
                      <div class="flex flex-wrap gap-2">
                          {profile.gear.map((item: string) => {
                              const icon = getDefaultIcon(item);
                              return (
                                  <div class="px-3 py-1.5 rounded-lg border border-zinc-100 bg-white/50 flex items-center gap-2 hover:bg-white hover:shadow-sm transition-all text-xs text-zinc-600">
                                      {icon ? <Icon name={icon} class="w-3.5 h-3.5" /> : <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan"></span>}
                                      <span>{item}</span>
                                  </div>
                              );
                          })}
                      </div>
                  </div>
              </section>

              <!-- Skills -->
              <section class="glass-card p-8 group overflow-hidden relative">
                  <div class="absolute -top-10 -right-10 w-40 h-40 bg-accent-violet/10 rounded-full blur-3xl group-hover:bg-accent-violet/20 transition-colors"></div>

                  <div class="relative z-10">
                      <div class="flex items-center gap-3 mb-6">
                          <div class="p-2 rounded-xl bg-accent-violet/10 text-accent-violet">
                              <Icon name="lucide:layers" class="w-5 h-5" />
                          </div>
                          <h2 class="text-xl font-display font-bold text-text-primary">Skills</h2>
                      </div>
                      <div class="space-y-6">
                          {skillCategories.map(({ label, items }) => (
                              <div>
                                  <h3 class="text-[10px] font-mono uppercase tracking-widest text-zinc-400 mb-2">{label}</h3>
                                  <div class="flex flex-wrap gap-2">
                                      {items.map((item: string) => {
                                          const icon = getDefaultIcon(item);
                                          return (
                                              <div class="px-3 py-1.5 rounded-lg border border-zinc-100 bg-white/50 flex items-center gap-2 hover:bg-white hover:shadow-sm transition-all text-xs text-zinc-600">
                                                  {icon ? <Icon name={icon} class="w-3.5 h-3.5" /> : <span class="w-1.5 h-1.5 rounded-full bg-accent-violet"></span>}
                                                  <span>{item}</span>
                                              </div>
                                          );
                                      })}
                                  </div>
                              </div>
                          ))}
                      </div>
                  </div>
              </section>

              <!-- Policy -->
              <section class="glass-card p-8 group">
                   <Icon name="lucide:sparkles" class="w-6 h-6 mb-4 text-accent-orange" />
                   <h3 class="text-lg font-bold font-display mb-2 text-text-primary">Policy</h3>
                   <p class="text-sm leading-relaxed text-zinc-500">
                       技術は課題解決の手段．<br>
                       常にユーザーの視点に立ち，シンプルかつ堅牢な実装で，長く愛されるシステムを作ります．
                   </p>
              </section>

          </div>

      </div>
  </main>

  <Footer />
</Layout>
