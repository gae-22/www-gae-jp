---
export const prerender = false;
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Timeline from '~/components/features/about/Timeline.astro';
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('about', 'profile');
if (!aboutEntry) {
    throw new Error('About profile not found');
}

const profile = aboutEntry.data;

const skillCategories = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks', items: profile.skills.frameworks },
  { label: 'Others', items: profile.skills.others },
];
---

<Layout title="About | gae" description="About gae.">
  <Header />

  <main class="min-h-screen pt-32 pb-20 px-4 sm:px-6 relative overflow-hidden">
      <div class="max-w-5xl mx-auto space-y-16 relative z-10">

          <!-- Page Header -->
          <header class="reveal-item">
            <div class="flex items-center gap-6 mb-6">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">About</span>
              <div class="flex-1 h-px bg-border-subtle"></div>
            </div>
            <h1 class="font-display font-extrabold text-6xl sm:text-8xl md:text-9xl tracking-tighter leading-[0.85] text-text-primary mb-4">
              HELLO<span class="text-text-tertiary">.</span>
            </h1>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-secondary flex items-center gap-3 mt-6">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-75" style="animation: pulse-accent 2s ease-in-out infinite;"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
              </span>
              {profile.name} — Fullstack Developer
            </p>
          </header>

          <!-- Stats Row -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4 reveal-item">
            <div class="p-6 rounded-2xl border border-border-subtle bg-void-subtle text-center hover:border-accent/20 transition-all duration-500">
              <span class="text-4xl font-display font-bold text-text-primary block mb-2">{profile.stats.experience}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Years Exp</span>
            </div>
            <div class="p-6 rounded-2xl border border-border-subtle bg-void-subtle text-center hover:border-accent/20 transition-all duration-500">
              <span class="text-4xl font-display font-bold text-text-primary block mb-2">{profile.stats.projects}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Projects</span>
            </div>
            <div class="p-6 rounded-2xl border border-border-subtle bg-void-subtle text-center hover:border-accent/20 transition-all duration-500 col-span-2 md:col-span-1">
              <span class="text-4xl font-display font-bold text-text-primary block mb-2">&infin;</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Curiosity</span>
            </div>
          </div>

          <!-- Skills Section -->
          <section class="reveal-item">
            <div class="flex items-center gap-6 mb-10">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">Skills</span>
              <div class="flex-1 h-px bg-border-subtle"></div>
            </div>
            <div class="space-y-8">
              {skillCategories.map(({ label, items }) => (
                <div>
                  <h4 class="font-mono text-[10px] uppercase tracking-[0.2em] text-text-tertiary mb-4">{label}</h4>
                  <div class="flex flex-wrap gap-2">
                    {items.map((item) => (
                      <div class="px-4 py-2 rounded-full border border-border-subtle bg-void-subtle flex items-center gap-2.5 hover:border-accent/20 hover:bg-void-elevated transition-all duration-300 group cursor-default">
                        <Icon name={item.icon} class="w-4 h-4 text-text-secondary group-hover:text-accent transition-colors duration-300" />
                        <span class="font-mono text-xs text-text-secondary group-hover:text-text-primary transition-colors duration-300">{item.name}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Gear Section -->
          <section class="reveal-item">
            <div class="flex items-center gap-6 mb-10">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">Gear</span>
              <div class="flex-1 h-px bg-border-subtle"></div>
            </div>
            <div class="flex flex-wrap gap-2">
              {profile.gear.map((item) => (
                <div class="px-4 py-2 rounded-full border border-border-subtle bg-void-subtle flex items-center gap-2.5 hover:border-accent/20 transition-all duration-300 group cursor-default">
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-text-tertiary group-hover:text-text-secondary transition-colors duration-300" />
                  <span class="font-mono text-xs text-text-secondary group-hover:text-text-primary transition-colors duration-300">{item.name}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Timeline Section -->
          <section class="reveal-item">
            <div class="flex items-center gap-6 mb-10">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">Journey</span>
              <div class="flex-1 h-px bg-border-subtle"></div>
            </div>
            <div class="p-8 md:p-12 rounded-2xl border border-border-subtle bg-void-subtle">
              <Timeline events={profile.timeline} />
            </div>
          </section>

          <!-- Philosophy -->
          <section class="reveal-item py-20">
            <div class="max-w-3xl">
              <h3 class="flex items-center gap-3 mb-10">
                <span class="w-8 h-px bg-accent"></span>
                <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">Philosophy</span>
              </h3>
              <p class="text-3xl sm:text-4xl md:text-5xl leading-[1.1] text-text-primary font-display font-bold tracking-tight mb-6">
                技術は課題解決の手段。
              </p>
              <div class="h-px w-full bg-border-subtle my-8"></div>
              <div class="text-lg text-text-secondary leading-relaxed space-y-2">
                <p>常にユーザーの視点に立ち、シンプルかつ堅牢な実装で、</p>
                <p class="text-text-primary font-bold">"長く愛されるシステムを作ります。"</p>
              </div>
            </div>
          </section>

      </div>
  </main>

  <Footer />
</Layout>
