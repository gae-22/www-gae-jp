---
import Layout from '~/layouts/Layout.astro';
---

<Layout title="404 | Not Found">
  <main class="min-h-screen w-full flex flex-col items-center justify-center relative overflow-hidden bg-void">

    <!-- Content -->
    <div class="relative z-10 text-center space-y-8 px-4">
        <div class="relative inline-block">
            <h1 class="text-[6rem] sm:text-[8rem] md:text-[12rem] font-display font-bold leading-none text-text-tertiary select-none">
                404
            </h1>
        </div>

        <div class="space-y-4 max-w-lg mx-auto">
            <h2 class="text-3xl font-bold text-text-primary tracking-tight">Page Not Found</h2>
            <p class="text-text-secondary text-lg">
                お探しのページは見つかりませんでした。
            </p>
        </div>

        <div class="pt-4">
            <a href="/" class="link-hover font-mono text-sm text-accent inline-flex items-center gap-2">
                トップページへ戻る
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
    </div>

  </main>
</Layout>
