---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
---

<Layout title="404 | Not Found">
  <Header />

  <main class="min-h-screen w-full flex flex-col items-center justify-center relative overflow-hidden bg-void">

    {/* Floating accent dots */}
    <div class="floating-dot" style="top: 20%; right: 20%; animation-delay: 0s; animation-duration: 14s;"></div>
    <div class="floating-dot" style="top: 60%; left: 15%; animation-delay: -5s; animation-duration: 18s; opacity: 0.2;"></div>
    <div class="floating-dot" style="top: 40%; right: 30%; animation-delay: -10s; animation-duration: 16s; opacity: 0.15;"></div>

    <!-- Content -->
    <div class="relative z-10 text-center space-y-7 sm:space-y-10 px-4">
        <div class="relative inline-block">
            <h1 class="text-[5rem] sm:text-[8rem] md:text-[12rem] font-display font-bold leading-none text-text-tertiary select-none glitch-text reveal-scale tracking-tighter" data-text="404">
                404
            </h1>
        </div>

        <div class="space-y-3.5 sm:space-y-5 max-w-lg mx-auto reveal-item reveal-delay-2">
            <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight">Page Not Found</h2>
            <p class="text-text-secondary text-base sm:text-lg leading-relaxed">
                お探しのページは見つかりませんでした。
            </p>
        </div>

        <div class="pt-5 reveal-item reveal-delay-3">
            <a href="/" class="link-hover font-mono text-sm text-accent inline-flex items-center gap-2.5" data-magnetic data-scramble>
                トップページへ戻る
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
    </div>

  </main>

  <Footer />
</Layout>
