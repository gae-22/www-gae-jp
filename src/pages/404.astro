---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import ErrorTemplate from '~/components/errors/ErrorTemplate.astro';
import { errorCodes } from '~/data/errorCodes';

const error404 = errorCodes.find(e => e.code === 404);

if (!error404) {
    throw new Error('404 error code definition not found in errorCodes.ts');
}

const pageTitle = `${error404.code} | ${error404.name}`;
---

<Layout title={pageTitle}>
    <Header />
    <ErrorTemplate error={error404} />
    <Footer />
</Layout>
