---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import { errorCodes } from '~/data/errorCodes';

// Group by priority
const groupedErrors = errorCodes.reduce((acc, error) => {
    if (!acc[error.priority]) {
        acc[error.priority] = [];
    }
    acc[error.priority].push(error);
    return acc;
}, {} as Record<string, typeof errorCodes>);

const priorities = ['S', 'A', 'B', 'C'];
const totalErrors = errorCodes.length;
---

<Layout title="SYSTEM STATUS | DEBUG">
    <Header />

    <main class="min-h-screen w-full pt-32 pb-20 px-4 sm:px-8 bg-void relative overflow-hidden font-mono">
        {/* Background Grid */}
        <div class="absolute inset-0 z-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"></div>
        <div class="absolute inset-0 z-0 bg-gradient-to-b from-void via-transparent to-void pointer-events-none"></div>

        <div class="max-w-7xl mx-auto relative z-10">

            {/* Dashboard Header */}
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 border-b border-white/10 pb-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse shadow-[0_0_10px_#22c55e]"></div>
                        <span class="text-xs tracking-[0.2em] text-green-500 uppercase">System Online</span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-display font-bold text-white tracking-tight">
                        SYSTEM <span class="stroke-text">STATUS</span>
                    </h1>
                    <p class="text-text-secondary max-w-xl text-sm leading-relaxed">
                        > DIAGNOSTIC_TOOL_V2.0.4<br/>
                        > MONITORING {totalErrors} ERROR PROTOCOLS
                    </p>
                </div>
                <div class="mt-8 md:mt-0 flex gap-12 text-right">
                    <div>
                        <div class="text-[10px] text-text-tertiary uppercase tracking-wider mb-1">Total Protocols</div>
                        <div class="text-3xl font-display font-bold text-white">{totalErrors}</div>
                    </div>
                    <div>
                        <div class="text-[10px] text-text-tertiary uppercase tracking-wider mb-1">Status Check</div>
                        <div class="text-3xl font-display font-bold text-accent">Active</div>
                    </div>
                </div>
            </div>

            {/* Error Grid */}
            <div class="space-y-24">
                {priorities.map((priority) => (
                    groupedErrors[priority] && (
                        <section class="relative">
                            <div class="sticky top-20 z-20 pb-6 mb-6 border-b border-white/10 bg-void/95 backdrop-blur-md flex items-end justify-between">
                                <div class="flex items-end gap-4">
                                    <h2 class="text-4xl font-display font-bold text-white opacity-20 select-none">PRIORITY {priority}</h2>
                                    <div class="pb-1 pl-4 border-l border-white/20">
                                         <span class="text-[10px] font-mono text-accent uppercase tracking-widest block">
                                            {priority === 'S' && 'Critical Infrastructure'}
                                            {priority === 'A' && 'UX Optimization Layer'}
                                            {priority === 'B' && 'Anomalies / Easter Eggs'}
                                            {priority === 'C' && 'Edge Cases / Network'}
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                {groupedErrors[priority].map((error) => (
                                    <a href={`/${error.code}`} class="group relative block bg-void-elevated border border-white/5 hover:border-accent/40 transition-all duration-300 hover:-translate-y-1 overflow-hidden rounded-lg">

                                        <div class="absolute top-0 right-0 p-3 opacity-50 group-hover:opacity-100 transition-opacity">
                                             <span class="text-[9px] font-mono uppercase tracking-wider text-text-tertiary px-2 py-1 rounded bg-black/40 border border-white/10 group-hover:border-accent/30 group-hover:text-accent transition-colors">
                                                {error.designType}
                                            </span>
                                        </div>

                                        <div class="p-6 pt-10 relative z-10">
                                            <div class="flex items-baseline gap-2 mb-2">
                                                 <span class={`font-display font-bold text-4xl transition-colors duration-300 ${priority === 'S' ? 'text-red-500 group-hover:text-red-400' : 'text-white group-hover:text-accent'}`}>
                                                    {error.code}
                                                </span>
                                            </div>

                                            <h3 class="font-bold text-text-primary text-sm mb-2 group-hover:text-white transition-colors">{error.name}</h3>
                                            <p class="text-xs text-text-tertiary line-clamp-2 leading-relaxed group-hover:text-text-secondary transition-colors">{error.message}</p>
                                        </div>

                                        {/* Hover Overlay Gradient */}
                                        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                                        {/* Tech decoration on hover */}
                                        <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-accent group-hover:w-full transition-all duration-500 ease-out"></div>
                                    </a>
                                ))}
                            </div>
                        </section>
                    )
                ))}
            </div>

            <div class="mt-32 pt-8 border-t border-white/10 text-center text-[10px] tracking-widest text-text-tertiary uppercase">
                <p>END OF DIAGNOSTIC REPORT // GENERATED BY ASTRO BUILD SYSTEM</p>
            </div>
        </div>
    </main>

    <Footer />
</Layout>

<style>
    .stroke-text {
        -webkit-text-stroke: 1px var(--color-accent);
        color: transparent;
    }
</style>
