---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import Timeline from '~/components/features/about/Timeline.astro';
import { Icon } from 'astro-icon/components';
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('about', 'profile');
if (!aboutEntry) {
    throw new Error('About profile not found');
}

const profile = aboutEntry.data;

const skillCategories = [
  { label: 'Languages', items: profile.skills.languages },
  { label: 'Frameworks', items: profile.skills.frameworks },
  { label: 'Others', items: profile.skills.others },
];
---

<Layout title="About | gae" description="About gae.">
  <Header />

  <main class="min-h-screen pt-24 sm:pt-32 pb-20 sm:pb-24 px-4 sm:px-6 relative overflow-hidden">
      <div class="max-w-5xl mx-auto space-y-14 sm:space-y-20 relative z-10">

          {/* Floating accent dots */}
          <div class="floating-dot" style="top: 8%; right: 12%; animation-delay: 0s; animation-duration: 14s;"></div>
          <div class="floating-dot" style="top: 35%; left: 5%; animation-delay: -4s; animation-duration: 18s; opacity: 0.2;"></div>
          <div class="floating-dot" style="top: 65%; right: 8%; animation-delay: -8s; animation-duration: 16s; opacity: 0.15;"></div>

          <!-- Page Header -->
          <header class="reveal-item" data-scroll-skew>
            <div class="page-section-label reveal-item">
              <span>About</span>
              <div class="section-line-animated"></div>
            </div>
            <h1 class="page-title text-5xl sm:text-6xl md:text-9xl mb-4 tracking-tighter" data-scramble>
              HELLO<span class="text-text-tertiary">.</span>
            </h1>
            <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-text-secondary flex items-center gap-3 mt-5">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-75" style="animation: pulse-accent 2s ease-in-out infinite;"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
              </span>
              {profile.name} — Fullstack Developer
            </p>
          </header>

          <!-- Stats Row with count-up -->
          <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5 reveal-item">
            <div class="stat-card" data-cursor-text="EXP">
              <span class="text-3xl sm:text-4xl font-display font-bold text-text-primary block mb-2.5 count-up" data-count-target={String(profile.stats.experience)} data-count-suffix="+">0</span>
              <span class="font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Years Exp</span>
            </div>
            <div class="stat-card" data-cursor-text="PRJ">
              <span class="text-3xl sm:text-4xl font-display font-bold text-text-primary block mb-2.5 count-up" data-count-target={String(profile.stats.projects)} data-count-suffix="+">0</span>
              <span class="font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Projects</span>
            </div>
            <div class="stat-card col-span-2 md:col-span-1" data-cursor-text="∞">
              <span class="text-3xl sm:text-4xl font-display font-bold text-text-primary block mb-2.5">&infin;</span>
              <span class="font-mono text-[9px] sm:text-[10px] uppercase tracking-[0.2em] text-text-tertiary">Curiosity</span>
            </div>
          </div>

          <!-- Skills Section -->
          <section class="reveal-item" data-scroll-skew>
            <div class="page-section-label reveal-item reveal-delay-1">
              <span>Skills</span>
              <div class="section-line-animated"></div>
            </div>
            <div class="space-y-10">
              {skillCategories.map(({ label, items }, catIdx) => (
                <div class="reveal-item" style={`transition-delay: ${catIdx * 0.15}s`}>
                  <h4 class="font-mono text-[10px] uppercase tracking-[0.25em] text-text-tertiary mb-4">{label}</h4>
                  <div class="flex flex-wrap gap-2.5">
                    {items.map((item, i) => (
                      <div class="skill-pill reveal-scale" style={`transition-delay: ${catIdx * 0.15 + i * 0.05}s`} data-magnetic>
                        <Icon name={item.icon} class="w-4 h-4 text-text-secondary group-hover:text-accent transition-colors duration-300" />
                        <span class="font-mono text-xs text-text-secondary group-hover:text-text-primary transition-colors duration-300">{item.name}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Gear Section -->
          <section class="reveal-item" data-scroll-skew>
            <div class="page-section-label reveal-item">
              <span>Gear</span>
              <div class="section-line-animated"></div>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {profile.gear.map((item, i) => (
                <div class="skill-pill reveal-scale" style={`transition-delay: ${i * 0.06}s`} data-magnetic>
                  <Icon name={item.icon} class="w-3.5 h-3.5 text-text-tertiary group-hover:text-text-secondary transition-colors duration-300" />
                  <span class="font-mono text-xs text-text-secondary group-hover:text-text-primary transition-colors duration-300">{item.name}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Timeline Section -->
          <section class="reveal-item">
            <div class="page-section-label reveal-item">
              <span>Journey</span>
              <div class="section-line-animated"></div>
            </div>
            <div class="p-6 sm:p-8 md:p-12 rounded-2xl border border-border-subtle bg-void-subtle/80 animated-border">
              <Timeline events={profile.timeline} />
            </div>
          </section>

          <!-- Philosophy -->
          <section class="reveal-item py-14 sm:py-24" data-scroll-skew>
            <div class="max-w-3xl">
              <h3 class="flex items-center gap-3 mb-8 sm:mb-12">
                <span class="w-8 h-px bg-accent"></span>
                <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent">Philosophy</span>
              </h3>
              <p class="text-2xl sm:text-3xl md:text-5xl leading-[1.1] text-text-primary font-display font-bold tracking-tight mb-5 sm:mb-6">
                技術は課題解決の手段。
              </p>
              <div class="h-px w-full bg-border-subtle my-8 sm:my-10 section-line revealed" style="animation: line-expand 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;"></div>
              <div class="text-lg text-text-secondary leading-relaxed space-y-3">
                <p>常にユーザーの視点に立ち、シンプルかつ堅牢な実装で、</p>
                <p class="text-text-primary font-bold">&ldquo;長く愛されるシステムを作ります。&rdquo;</p>
              </div>
            </div>
          </section>

      </div>
  </main>

  <Footer />
</Layout>

<script>
  // Count-up animation for about page stats
  function initAboutCountUp() {
    const counters = document.querySelectorAll<HTMLElement>('.count-up');
    if (!counters.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.countTarget || '0');
          const suffix = el.dataset.countSuffix || '';
          let current = 0;
          const duration = 2000;
          const start = performance.now();

          function update(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            // Ease-out expo
            const eased = 1 - Math.pow(2, -10 * progress);
            current = Math.round(target * eased);
            el.textContent = current + suffix;
            if (progress < 1) requestAnimationFrame(update);
          }
          requestAnimationFrame(update);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(c => observer.observe(c));
  }

  // Mouse-follow glow on stat cards
  function initStatCardGlow() {
    document.querySelectorAll<HTMLElement>('.stat-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        card.style.setProperty('--glow-x', `${x}%`);
        card.style.setProperty('--glow-y', `${y}%`);
      });
    });
  }

  function initAboutPage() {
    initAboutCountUp();
    initStatCardGlow();
  }

  document.addEventListener('DOMContentLoaded', initAboutPage);
  document.addEventListener('astro:after-swap', initAboutPage);
</script>
