---
export interface Props {
    events: {
        year: string;
        title: string;
        company: string;
        description?: string;
    }[];
}

const { events } = Astro.props;
---

<div class="relative space-y-12">
  {/* Continuous Line — animated gradient */}
  <div class="absolute left-3 top-2 bottom-2 w-px bg-linear-to-b from-accent/30 via-border-hover to-transparent"></div>

  {events.map((event, index) => (
    <div class="relative pl-10 group/timeline-item reveal-item" style={`transition-delay: ${index * 0.1}s`}>
      {/* Timeline Node — with pulse */}
      <div class="absolute left-1.5 top-2 w-3 h-3 rounded-full bg-void-elevated border border-border-hover flex items-center justify-center z-10 transition-all duration-500 group-hover/timeline-item:border-accent/40 group-hover/timeline-item:shadow-[0_0_0_4px_rgba(200,255,0,0.08)] group-hover/timeline-item:scale-125">
        <div class="w-1 h-1 rounded-full bg-text-tertiary group-hover/timeline-item:bg-accent transition-colors duration-500"></div>
      </div>

      {/* Content */}
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 mb-2">
           <h3 class="text-lg font-bold text-text-primary leading-none group-hover/timeline-item:text-accent transition-colors duration-300 tracking-tight">{event.title}</h3>
           <span class="text-[10px] font-bold uppercase tracking-widest text-text-tertiary bg-void-elevated px-3 py-1 rounded-full border border-border-subtle group-hover/timeline-item:border-accent/20 group-hover/timeline-item:text-accent transition-all duration-300 self-start sm:self-auto">
             {event.year}
           </span>
      </div>

      <div class="mb-3">
           <span class="text-xs font-bold tracking-wider text-text-secondary uppercase flex items-center gap-1 group-hover/timeline-item:text-text-primary transition-colors">
             {event.company}
           </span>
      </div>

      {event.description && (
          <p class="text-sm leading-relaxed text-text-secondary max-w-xl border-l-2 border-transparent pl-0 group-hover/timeline-item:pl-4 group-hover/timeline-item:border-accent/20 transition-all duration-300">
              {event.description}
          </p>
      )}
    </div>
  ))}
</div>
