---
const currentYear = new Date().getFullYear();
---

<section id="hero" class="relative min-h-svh flex flex-col items-center justify-center px-4 sm:px-6 overflow-hidden">

  <!-- Subtle animated grid lines background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Vertical grid lines with shimmer -->
    <div class="hero-grid-line absolute left-[20%] top-0 bottom-0 w-px bg-border-subtle opacity-30" style="--shimmer-delay: 0s;"></div>
    <div class="hero-grid-line absolute left-[40%] top-0 bottom-0 w-px bg-border-subtle opacity-20" style="--shimmer-delay: 2s;"></div>
    <div class="hero-grid-line absolute left-[60%] top-0 bottom-0 w-px bg-border-subtle opacity-20" style="--shimmer-delay: 4s;"></div>
    <div class="hero-grid-line absolute left-[80%] top-0 bottom-0 w-px bg-border-subtle opacity-30" style="--shimmer-delay: 6s;"></div>

    <!-- Horizontal scanning line — a faint line that slowly sweeps down -->
    <div class="hero-scan-line absolute left-0 right-0 h-px bg-accent/4"></div>

    <!-- Floating gradient blobs in hero -->
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
  </div>

  <!-- Animated radial gradient that follows mouse -->
  <div id="hero-mouse-gradient" class="absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-1000" aria-hidden="true"></div>

  <!-- Hero Headlines -->
  <div class="relative z-10 flex flex-col items-start w-full max-w-7xl">

    <!-- Top meta line -->
    <div class="fade-up mb-10 sm:mb-14 md:mb-20 flex items-center gap-4 sm:gap-6" style="animation-delay: 0.3s;">
      <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.3em] text-text-tertiary">Portfolio {currentYear}</span>
      <span class="w-10 sm:w-14 h-px bg-border-hover"></span>
    </div>

    <div class="hero-lines" aria-label="gae Software Engineer">
      <div class="hero-line-js overflow-hidden">
        <h1 class="text-display text-[clamp(2.75rem,12vw,11rem)] sm:text-[clamp(3.5rem,13vw,11rem)] font-extrabold text-text-primary leading-[0.88] sm:leading-[0.85] tracking-[-0.03em] sm:tracking-[-0.04em]">
          gae
        </h1>
      </div>
      <div class="hero-line-js overflow-hidden">
        <h1 class="text-display text-[clamp(2.75rem,12vw,11rem)] sm:text-[clamp(3.5rem,13vw,11rem)] font-extralight text-text-secondary leading-[0.88] sm:leading-[0.85] tracking-[-0.03em] sm:tracking-[-0.04em]">
          Software
        </h1>
      </div>
      <div class="hero-line-js overflow-hidden">
        <h1 class="text-display text-[clamp(2.75rem,12vw,11rem)] sm:text-[clamp(3.5rem,13vw,11rem)] font-extrabold text-text-primary leading-[0.88] sm:leading-[0.85] tracking-[-0.03em] sm:tracking-[-0.04em]">
          Engineer
        </h1>
      </div>
      <!-- Available indicator — separate line on mobile, inline on desktop -->
      <div class="hero-line-js overflow-hidden mt-3 sm:mt-4 md:mt-6">
        <span class="inline-flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-accent" style="animation: pulse-accent 2s ease-in-out infinite;" aria-hidden="true"></span>
          <span class="font-mono text-[9px] md:text-[10px] uppercase tracking-[0.3em] text-accent leading-none">Available for work</span>
        </span>
      </div>
    </div>

    <!-- Sub copy -->
    <div class="mt-8 sm:mt-12 md:mt-16">
      <p class="fade-up font-mono text-[9px] sm:text-[10px] md:text-[11px] uppercase tracking-[0.15em] sm:tracking-[0.2em] text-text-secondary/80" style="animation-delay: 1.3s;">
        Based in Tokyo — Crafting digital experiences
      </p>
    </div>

  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 sm:bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2.5 sm:gap-3 fade-up" style="animation-delay: 2s;">
    <span class="font-mono text-[8px] uppercase tracking-[0.3em] text-text-tertiary">Scroll</span>
    <div class="w-px h-7 sm:h-9 bg-text-tertiary/60 origin-top" style="animation: scroll-bounce 2.5s ease-in-out infinite;"></div>
  </div>

  <!-- Bottom line separator -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-border-subtle"></div>

</section>

<style>
  /* Grid line shimmer — a bright spot slowly travels down each line */
  .hero-grid-line {
    overflow: hidden;
  }
  .hero-grid-line::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 80px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(200, 255, 0, 0.12) 50%,
      transparent 100%
    );
    animation: grid-shimmer 8s ease-in-out infinite;
    animation-delay: var(--shimmer-delay, 0s);
  }

  /* Horizontal scanning line — sweeps down continuously */
  .hero-scan-line {
    animation: scan-line 12s linear infinite;
  }

  /* Floating gradient blobs */
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform;
  }
  .hero-blob-1 {
    width: clamp(200px, 30vw, 400px);
    height: clamp(200px, 30vw, 400px);
    background: radial-gradient(circle, rgba(200, 255, 0, 0.05) 0%, transparent 70%);
    top: 10%;
    right: 5%;
    animation: hero-float-1 20s ease-in-out infinite;
  }
  .hero-blob-2 {
    width: clamp(150px, 25vw, 350px);
    height: clamp(150px, 25vw, 350px);
    background: radial-gradient(circle, rgba(100, 180, 255, 0.03) 0%, transparent 70%);
    bottom: 15%;
    left: 10%;
    animation: hero-float-2 25s ease-in-out infinite;
  }

  /* Hero text breathing effect — no opacity change */
  .hero-lines {
    /* Removed animation to avoid hiding content */
  }

  /* CSS-driven hero line reveal — no JS dependency for LCP */
  .hero-line-js {
    animation: hero-line-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-line-js:nth-child(1) { animation-delay: 0.05s; }
  .hero-line-js:nth-child(2) { animation-delay: 0.15s; }
  .hero-line-js:nth-child(3) { animation-delay: 0.25s; }
  .hero-line-js:nth-child(4) { animation-delay: 0.35s; }

  @keyframes hero-line-in {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0;
    }
    to {
      clip-path: inset(0% 0 0 0);
      opacity: 1;
    }
  }

  @keyframes hero-float-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-5vw, 3vh) scale(1.1); }
    50% { transform: translate(3vw, -5vh) scale(0.95); }
    75% { transform: translate(-2vw, -2vh) scale(1.05); }
  }

  @keyframes hero-float-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(4vw, -4vh) scale(1.08); }
    66% { transform: translate(-3vw, 3vh) scale(0.92); }
  }

  @keyframes hero-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.005); }
  }

  @keyframes grid-shimmer {
    0%, 100% {
      top: -80px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: calc(100% + 80px);
      opacity: 0;
    }
  }

  @keyframes scan-line {
    0% {
      top: -1px;
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    95% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  /* Optimize for mobile: reduce background effects */
  @media (max-width: 767px) {
    .hero-blob {
      filter: blur(60px);
      opacity: 0.5;
      will-change: auto;
    }
    .hero-blob-1 {
      animation-duration: 30s;
    }
    .hero-blob-2 {
      animation-duration: 35s;
    }
    .hero-scan-line {
      display: none;
    }
    .hero-grid-line::after {
      animation-duration: 12s;
    }
  }

  /* Faster hero reveal on mobile for better LCP */
  @media (max-width: 767px) {
    .hero-line-js {
      animation-duration: 0.6s;
    }
    .hero-line-js:nth-child(1) { animation-delay: 0s; }
    .hero-line-js:nth-child(2) { animation-delay: 0.06s; }
    .hero-line-js:nth-child(3) { animation-delay: 0.12s; }
    .hero-line-js:nth-child(4) { animation-delay: 0.18s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid-line::after,
    .hero-scan-line,
    .hero-blob {
      animation: none !important;
      opacity: 0 !important;
    }
    .hero-line-js {
      animation: none !important;
      clip-path: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  function initHeroMouseGradient() {
    // Skip on touch/mobile devices — desktop-only effect
    if (window.matchMedia('(hover: none)').matches) return;

    const hero = document.getElementById('hero');
    const gradient = document.getElementById('hero-mouse-gradient');
    if (!hero || !gradient) return;

    hero.addEventListener('mouseenter', () => {
      gradient.style.opacity = '1';
    });
    hero.addEventListener('mouseleave', () => {
      gradient.style.opacity = '0';
    });
    hero.addEventListener('mousemove', (e) => {
      const rect = hero.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      gradient.style.background = `radial-gradient(600px circle at ${x}% ${y}%, rgba(200, 255, 0, 0.04), transparent 40%)`;
    });
  }

  document.addEventListener('DOMContentLoaded', initHeroMouseGradient);
  document.addEventListener('astro:after-swap', initHeroMouseGradient);
</script>
