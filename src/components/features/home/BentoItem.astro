---
interface Props {
  class?: string;
  title?: string;
  href?: string;
  style?: string;
}

const { class: className, title, href, style } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  target={href?.startsWith('http') ? '_blank' : undefined}
  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
  class:list={["glass-card group relative block overflow-hidden hover-target", className]}
  style={style}
  data-tilt
>
  <!-- Glow on hover -->
  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none bg-linear-to-tr from-indigo-500/5 via-transparent to-orange-500/5"></div>

  {title && (
    <div class="absolute top-6 left-6 z-20 pointer-events-none">
      <h3 class="text-[10px] font-mono uppercase tracking-[0.25em] text-zinc-400 group-hover:text-zinc-600 transition-colors">{title}</h3>
    </div>
  )}

  <div class="relative z-10 w-full h-full">
    <slot />
  </div>
</Tag>

<script>
  // 3D Tilt Effect - Refined for 2026 Soft Feel
  function initTilt() {
    const cards = document.querySelectorAll('[data-tilt]');
    if (!cards.length) return;

    cards.forEach(card => {
        const el = card as HTMLElement;

        const handleMove = (e: MouseEvent) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            // Subtler tilt angles
            const rotateX = ((y - centerY) / centerY) * -2; // Reduced from -4
            const rotateY = ((x - centerX) / centerX) * 2;  // Reduced from 4

            el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
        };

        const handleLeave = () => {
            el.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) scale3d(1, 1, 1)';
        };

        el.addEventListener('mousemove', handleMove);
        el.addEventListener('mouseleave', handleLeave);
    });
  }

  // Run on load and after swaps
  document.addEventListener('DOMContentLoaded', initTilt);
  document.addEventListener('astro:after-swap', initTilt);
</script>
