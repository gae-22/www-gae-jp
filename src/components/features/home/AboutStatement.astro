---
const lines = [
  '東京を拠点に活動するソフトウェアエンジニア。',
  'パフォーマンスと美しさの両立を追求し、',
  'フロントエンドからバックエンドまで',
  '一気通貫でプロダクトを作り上げる。',
];
---

<section class="relative z-10 py-24 sm:py-40 md:py-56 px-4 sm:px-6 overflow-hidden">
  <!-- Floating accent dots — always moving -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="about-float-dot about-float-dot-1"></div>
    <div class="about-float-dot about-float-dot-2"></div>
    <div class="about-float-dot about-float-dot-3"></div>
  </div>

  <div class="max-w-3xl mx-auto relative">

    <!-- Label with line -->
    <div class="flex items-center gap-4 sm:gap-6 mb-10 sm:mb-16 reveal-item">
      <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent" style="animation: float-subtle 5s ease-in-out infinite;">
        About
      </span>
      <div class="flex-1 h-px bg-border-subtle"></div>
    </div>

    <!-- Statement — word-by-word reveal on scroll -->
    <div id="about-statement" class="space-y-3">
      {lines.map((line, lineIdx) => (
        <p class="text-lg sm:text-xl md:text-2xl lg:text-[1.75rem] font-body font-normal leading-relaxed sm:leading-loose tracking-[0.02em]" data-line={lineIdx}>
          {line.split('').map((char, charIdx) => (
            <span
              class="word-reveal"
              data-word-idx={lineIdx * 100 + charIdx}
              style={`transition-delay: ${charIdx * 0.02}s`}
            >{char}</span>
          ))}
        </p>
      ))}
    </div>

  </div>
</section>

<style>
  /* Floating accent dots in About section */
  .about-float-dot {
    position: absolute;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.1;
  }
  .about-float-dot-1 {
    width: 6px;
    height: 6px;
    top: 20%;
    right: 15%;
    animation: about-dot-float 12s ease-in-out infinite;
  }
  .about-float-dot-2 {
    width: 4px;
    height: 4px;
    top: 60%;
    left: 8%;
    animation: about-dot-float 15s ease-in-out infinite reverse;
  }
  .about-float-dot-3 {
    width: 3px;
    height: 3px;
    bottom: 25%;
    right: 25%;
    animation: about-dot-float 18s ease-in-out infinite;
    animation-delay: -5s;
  }

  @keyframes about-dot-float {
    0%, 100% { transform: translate(0, 0); opacity: 0.1; }
    25% { transform: translate(20px, -15px); opacity: 0.2; }
    50% { transform: translate(-10px, 10px); opacity: 0.08; }
    75% { transform: translate(15px, 20px); opacity: 0.15; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-float-dot {
      animation: none !important;
    }
  }
</style>

<script>
  function initWordReveal() {
    const statement = document.getElementById('about-statement');
    if (!statement) return;

    const words = statement.querySelectorAll<HTMLElement>('.word-reveal');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Activate all words with stagger
            words.forEach((word, i) => {
              setTimeout(() => {
                word.classList.add('word-active');
              }, i * 15);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3, rootMargin: '0px 0px -60px 0px' }
    );

    observer.observe(statement);
  }

  document.addEventListener('DOMContentLoaded', initWordReveal);
  document.addEventListener('astro:after-swap', initWordReveal);
</script>
