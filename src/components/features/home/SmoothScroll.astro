---
/**
 * SmoothScroll — Lenis smooth scroll + scroll velocity effects.
 *
 * 1. Lenis for buttery smooth scrolling (de facto standard in 2026)
 * 2. Scroll velocity-based skew on [data-scroll-skew] elements
 * 3. Scroll progress tracking
 */
---

<script>
  import Lenis from 'lenis';

  let lenis: Lenis | null = null;

  function initSmoothScroll() {
    // Cleanup existing instance
    if (lenis) {
      lenis.destroy();
    }

    lenis = new Lenis({
      duration: 1.2,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      touchMultiplier: 2,
      infinite: false,
    });

    let scrollVelocity = 0;

    lenis.on('scroll', (e: any) => {
      scrollVelocity = e.velocity;

      // Apply velocity-based skew to marked elements
      const skewElements = document.querySelectorAll<HTMLElement>('[data-scroll-skew]');
      const skew = Math.max(-5, Math.min(5, scrollVelocity * 0.8));
      skewElements.forEach(el => {
        el.style.transform = `skewY(${skew}deg)`;
      });
    });

    function raf(time: number) {
      lenis!.raf(time);
      requestAnimationFrame(raf);

      // Reset skew smoothly when velocity approaches 0
      if (Math.abs(scrollVelocity) < 0.01) {
        const skewElements = document.querySelectorAll<HTMLElement>('[data-scroll-skew]');
        skewElements.forEach(el => {
          el.style.transform = 'skewY(0deg)';
        });
      }
    }

    requestAnimationFrame(raf);
  }

  // Cleanup on page nav
  document.addEventListener('astro:before-swap', () => {
    if (lenis) {
      lenis.destroy();
      lenis = null;
    }
  });

  document.addEventListener('DOMContentLoaded', initSmoothScroll);
  document.addEventListener('astro:after-swap', initSmoothScroll);
</script>

<style is:global>
  /* Lenis defaults */
  html.lenis, html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis.lenis-stopped {
    overflow: hidden;
  }

  /* Scroll skew elements smooth transition */
  [data-scroll-skew] {
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
</style>
